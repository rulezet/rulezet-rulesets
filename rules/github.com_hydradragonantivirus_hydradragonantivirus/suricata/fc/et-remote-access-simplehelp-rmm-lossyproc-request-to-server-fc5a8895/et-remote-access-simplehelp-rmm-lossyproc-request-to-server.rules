alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"ET REMOTE_ACCESS SimpleHelp RMM lossyproc Request to Server"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/lossyproc|3f|rand|3d|"; startswith; fast_pattern; pcre:"/^\d\x2e\d{10,}\x2e\d{10,}$/R"; http.request_body; content:"SG|5f|"; threshold:type limit,track by_src,count 5,seconds 300; reference:url,simple-help.com/; classtype:misc-activity; sid:2067966; rev:1; metadata:affected_product SimpleHelp, attack_target Client_and_Server, tls_state plaintext, created_at 2026_03_02, deployment Perimeter, performance_impact Low, confidence High, signature_severity Informational, tag RMM, updated_at 2026_03_02, mitre_tactic_id TA0011, mitre_tactic_name Command_And_Control, mitre_technique_id T1219, mitre_technique_name Remote_Access_Software; target:src_ip;)