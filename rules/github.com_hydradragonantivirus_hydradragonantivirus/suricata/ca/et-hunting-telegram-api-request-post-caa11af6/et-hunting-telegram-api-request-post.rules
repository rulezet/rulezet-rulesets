alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"ET HUNTING Telegram API Request (POST)"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/bot"; startswith; http.host; bsize:16; content:"api.telegram.org"; fast_pattern; threshold:type limit,count 1,seconds 300,track by_src; classtype:misc-activity; sid:2068492; rev:1; metadata:affected_product Windows_XP_Vista_7_8_10_Server_32_64_Bit, attack_target Client_Endpoint, tls_state TLSDecrypt, created_at 2026_03_30, deployment Perimeter, deployment SSLDecrypt, performance_impact Moderate, confidence High, signature_severity Informational, updated_at 2026_03_30, mitre_tactic_id TA0002, mitre_tactic_name Execution, mitre_technique_id T1059, mitre_technique_name Command_And_Scripting_Interpreter; target:src_ip;)