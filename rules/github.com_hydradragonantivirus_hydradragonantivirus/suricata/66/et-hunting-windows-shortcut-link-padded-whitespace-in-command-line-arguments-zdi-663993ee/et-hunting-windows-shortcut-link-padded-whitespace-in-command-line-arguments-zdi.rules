alert tcp any any -> $HOME_NET any (msg:"ET HUNTING Windows Shortcut Link Padded Whitespace in Command Line Arguments (ZDI-CAN-25373)"; flow:established,to_client; file.data; content:"|4c 00 00 00 01 14 02 00 00 00 00 00 c0 00 00 00 00 00 00 46|"; fast_pattern; pcre:"/^.*?(?:[\x09\x0a\x0b\x0c\x0d\x20]\x00){25,}/R"; reference:url,www.trendmicro.com/en_us/research/25/c/windows-shortcut-zero-day-exploit.html; classtype:misc-activity; sid:2065198; rev:1; metadata:created_at 2025_10_15, deployment Perimeter, deployment Internal, confidence High, signature_severity Major, updated_at 2025_10_15; target:dest_ip;)