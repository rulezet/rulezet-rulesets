alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"ET TA_ABUSED_SERVICES Observed Commonly Abused Online Service Domain (myportfolio .com in TLS SNI)"; flow:established,to_server; tls.sni; dotprefix; content:".myportfolio.com"; endswith; fast_pattern; threshold:type limit,count 1,seconds 300,track by_src; classtype:misc-activity; sid:2069443; rev:1; metadata:attack_target Client_Endpoint, created_at 2026_05_26, deployment Perimeter, confidence Medium, signature_severity Informational, updated_at 2026_05_26;)