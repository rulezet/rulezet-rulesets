alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"ET ADWARE_PUP Observed Activity Monitoring/Keylogger Domain (refog .com in TLS SNI)"; flow:established,to_server; tls.sni; dotprefix; content:".refog.com"; endswith; fast_pattern; classtype:pup-activity; sid:2068336; rev:1; metadata:affected_product Any, attack_target Client_and_Server, created_at 2026_03_19, deployment Perimeter, malware_family PUP, malware_family mipko, malware_family refog, performance_impact Low, confidence High, signature_severity Major, updated_at 2026_03_19, mitre_tactic_id TA0007, mitre_tactic_name Discovery, mitre_technique_id T1082, mitre_technique_name System_Information_Discovery;)