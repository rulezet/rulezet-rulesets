alert tcp $HOME_NET $FTP_PORTS -> any any (msg:"ET HUNTING FTP (passive) LIST Response NUL Byte After Timestamp"; flow:established,to_client; content:"|00|"; pcre:"/(?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)\x20{1,2}\d{1,2}\x20+(?:\d{2}:\d{2}|\d{4})\x00+/"; reference:url,github.com/califio/publications/tree/main/MADBugs/squidbleed; reference:cve,2026-47729; classtype:protocol-command-decode; sid:2071362; rev:1; metadata:affected_product Squid, tls_state TLSDecrypt, created_at 2026_08_03, deployment Perimeter, deployment SSLDecrypt, performance_impact Moderate, confidence High, signature_severity Minor, updated_at 2026_08_03;)