alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"ET REMOTE_ACCESS Observed Remote Monitoring and Management (RMM) Tool in TLS SNI (connectwise .com)"; flow:established,to_server; tls.sni; dotprefix; content:".connectwise.com"; endswith; fast_pattern; reference:url,lolrmm.io/tools/screenconnect; classtype:misc-activity; sid:2071201; rev:1; metadata:affected_product Any, attack_target Client_and_Server, created_at 2026_07_16, deployment Perimeter, performance_impact Low, confidence High, signature_severity Informational, tag RMM, updated_at 2026_07_16, mitre_tactic_id TA0011, mitre_tactic_name Command_And_Control, mitre_technique_id T1219, mitre_technique_name Remote_Access_Software; target:src_ip;)