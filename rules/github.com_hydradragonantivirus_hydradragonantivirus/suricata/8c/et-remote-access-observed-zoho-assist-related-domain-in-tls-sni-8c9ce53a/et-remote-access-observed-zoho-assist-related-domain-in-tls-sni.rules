alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"ET REMOTE_ACCESS Observed Zoho Assist Related Domain in TLS SNI"; flow:established,to_server; tls.sni; bsize:15; content:"assist.zoho.com"; fast_pattern; reference:url,github.com/magicsword-io/LOLRMM/blob/main/detections/sigma/zoho_assist_network_sigma.yml; reference:url,help.zoho.com/portal/en/kb/assist/user-guide/setup-zoho-assist/articles/custom-domain#Map_Your_Domain_to_Zoho_Assist; classtype:misc-activity; sid:2060614; rev:1; metadata:affected_product Windows_XP_Vista_7_8_10_Server_32_64_Bit, attack_target Client_and_Server, created_at 2025_03_05, deployment Perimeter, performance_impact Low, confidence High, signature_severity Informational, tag Zoho_Assist, tag RMM, updated_at 2025_03_05, mitre_tactic_id TA0011, mitre_tactic_name Command_And_Control, mitre_technique_id T1219, mitre_technique_name Remote_Access_Software;)