alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"ET INFO Observed Pastebin-like Service (mypaste .dev) in TLS SNI"; flow:established,to_server; tls.sni; dotprefix; content:".mypaste.dev"; endswith; fast_pattern; reference:url,github.com/BadSamuraiDev/bs-lists/blob/main/pastebins-code.txt; classtype:misc-activity; sid:2067015; rev:1; metadata:affected_product Any, attack_target Client_and_Server, created_at 2026_01_23, deployment Perimeter, performance_impact Low, confidence High, signature_severity Informational, updated_at 2026_01_23, mitre_tactic_id TA0011, mitre_tactic_name Command_And_Control, mitre_technique_id T1102, mitre_technique_name Web_Service;)