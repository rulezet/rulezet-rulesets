alert dns $HOME_NET any -> any any (msg:"ET REMOTE_ACCESS Remote Monitoring and Management (RMM) Tools in DNS Lookup (getscreen .me)"; dns.query; dotprefix; content:".getscreen.me"; nocase; endswith; reference:url,lolrmm.io/tools/getscreen; classtype:misc-activity; sid:2071204; rev:1; metadata:affected_product Any, attack_target Client_and_Server, created_at 2026_07_16, deployment Perimeter, performance_impact Low, confidence High, signature_severity Informational, tag RMM, tag GetScreen, updated_at 2026_07_16, mitre_tactic_id TA0011, mitre_tactic_name Command_And_Control, mitre_technique_id T1219, mitre_technique_name Remote_Access_Software; target:src_ip;)