      83 78 ?? ??
      0F 85 ?? ?? ?? ??
      8B 48 ??
      83 F9 ??
      0F 8C ?? ?? ?? ??
      83 F9 ??
      0F 8D ?? ?? ?? ??
      8B 40 ??
      83 F8 ??
      0F 8C ?? ?? ?? ??
      83 F8 ??
      0F 8D ?? ?? ?? ??
      53
      57
      68 ?? ?? ?? ??
      8D 85 ?? ?? ?? ??
      6A ??
      50
      C7 85 ?? ?? ?? ?? ?? ?? ?? ??
    }

  condition:
    uint16be(0) == 0x4d5a and any of them
}