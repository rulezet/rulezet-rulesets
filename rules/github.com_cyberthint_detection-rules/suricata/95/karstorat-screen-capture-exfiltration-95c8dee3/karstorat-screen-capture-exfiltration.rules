alert tcp $HOME_NET any -> $EXTERNAL_NET 15144 (msg:"KARSTORAT - Screen Capture Exfiltration"; flow:to_server,established; content:"/upload-screen"; http_uri; nocase; content:"user=admin"; http_uri; nocase; sid:1000003; rev:1; reference:url,github.com/cyberthint/Detection-Rules; classtype:trojan-activity; priority:1;   metadata:ruleset "KarstoRat";)