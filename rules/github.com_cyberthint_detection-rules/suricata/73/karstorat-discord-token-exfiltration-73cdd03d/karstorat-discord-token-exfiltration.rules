alert tcp $HOME_NET any -> $EXTERNAL_NET 15144 (msg:"KARSTORAT - Discord Token Exfiltration"; flow:to_server,established; content:"/upload-tokens"; http_uri; nocase; sid:1000007; rev:1; reference:url,github.com/cyberthint/Detection-Rules; classtype:trojan-activity; priority:1;   metadata:ruleset "KarstoRat";)