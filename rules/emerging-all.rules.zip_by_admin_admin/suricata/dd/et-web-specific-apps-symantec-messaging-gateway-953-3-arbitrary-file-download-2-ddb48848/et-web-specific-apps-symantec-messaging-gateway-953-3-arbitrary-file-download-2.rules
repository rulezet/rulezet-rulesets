alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET WEB_SPECIFIC_APPS Symantec Messaging Gateway 9.5.3-3 - Arbitrary file download 2"; flow:established,to_server; http.uri; content:"/brightmail/admin/restore/download.do?"; fast_pattern; content:"&localBackupFileSelection="; http.uri.raw; url_decode; content:"|2e 2e 2f|"; reference:url,www.symantec.com/security_response/securityupdates/detail.jsp?fid=security_advisory&pvid=security_advisory&year=2012&suid=20120827_00; classtype:attempted-user; sid:2016119; rev:6; metadata:created_at 2012_12_04, signature_severity Major, updated_at 2024_04_07;)