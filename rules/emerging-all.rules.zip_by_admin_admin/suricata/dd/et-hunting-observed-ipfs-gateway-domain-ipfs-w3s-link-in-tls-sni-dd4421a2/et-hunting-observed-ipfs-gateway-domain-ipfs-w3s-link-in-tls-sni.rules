alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"ET HUNTING Observed IPFS Gateway Domain (ipfs .w3s .link) in TLS SNI"; flow:established,to_server; tls.sni; dotprefix; content:".ipfs.w3s.link"; endswith; fast_pattern; reference:url,ipfs.github.io/public-gateway-checker/; reference:url,unit42.paloaltonetworks.com/ipfs-used-maliciously/; classtype:misc-activity; sid:2045145; rev:1; metadata:affected_product Any, attack_target Client_Endpoint, created_at 2023_04_21, deployment Perimeter, performance_impact Low, confidence High, signature_severity Informational, updated_at 2023_04_21;)