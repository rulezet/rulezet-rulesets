alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET WEB_SPECIFIC_APPS Joomla Component com_kkcontent Blind SQL Injection Attempt"; flow:established,to_server; http.uri; content:"/index.php?"; nocase; content:"option=com_kkcontent"; nocase; content:"catID="; nocase; pcre:"/(\?|&)catID=[^\x26\x3B]*[^\d\x2D]/i"; reference:url,www.packetstormsecurity.org/0912-exploits/joomlakkcontent-sql.txt; classtype:web-application-attack; sid:2010606; rev:6; metadata:affected_product Web_Server_Applications, attack_target Web_Server, created_at 2010_07_30, deployment Datacenter, signature_severity Major, tag SQL_Injection, updated_at 2020_09_11, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public_Facing_Application;)