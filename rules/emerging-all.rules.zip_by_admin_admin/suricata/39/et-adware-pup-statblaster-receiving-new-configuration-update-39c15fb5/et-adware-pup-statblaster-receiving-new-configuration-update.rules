alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"ET ADWARE_PUP Statblaster Receiving New configuration (update)"; flow:established,to_server; http.uri; content:"/updatestats/update"; nocase; content:".xml"; endswith; nocase; pcre:"/\/updatestats\/update\d+?\.xml$/"; http.host; content:"statblaster"; fast_pattern; http.user_agent; content:"update"; startswith; reference:url,securityresponse.symantec.com/avcenter/venc/data/adware.statblaster.html; classtype:pup-activity; sid:2001225; rev:13; metadata:created_at 2010_07_30, signature_severity Minor, updated_at 2024_03_01;)