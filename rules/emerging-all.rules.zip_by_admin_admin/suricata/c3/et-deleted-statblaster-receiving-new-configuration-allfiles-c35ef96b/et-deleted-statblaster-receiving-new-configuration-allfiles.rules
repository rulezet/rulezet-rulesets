alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"ET DELETED Statblaster Receiving New configuration (allfiles)"; flow: to_server,established; content:"/updatestats/all_files"; nocase; http_uri; reference:url,securityresponse.symantec.com/avcenter/venc/data/adware.statblaster.html; classtype:policy-violation; sid:2001523; rev:9; metadata:created_at 2010_07_30, signature_severity Unknown, updated_at 2019_07_26;)