alert http $EXTERNAL_NET any -> $HTTP_SERVERS any (msg:"ET WEB_SPECIFIC_APPS Possible HP OpenView Network Node Manager Getnnmdata.exe Invalid ICount Remote Code Execution Attempt"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/OvCgi/getnnmdata.exe"; fast_pattern; nocase; http.request_body; content:"ICount="; nocase; isdataat:100,relative; content:!"|0A|"; within:100; reference:url,www.zerodayinitiative.com/advisories/ZDI-10-085/; reference:cve,2010-1554; classtype:web-application-attack; sid:2011196; rev:5; metadata:created_at 2010_07_30, confidence Medium, signature_severity Major, updated_at 2024_03_11, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public_Facing_Application;)