alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"ET ADWARE_PUP Flingstone Spyware Install (sportsinteraction)"; flow:established,to_server; http.uri; content:"/softwares/SportsInteraction.exe"; nocase; reference:url,securityresponse.symantec.com/avcenter/venc/data/adware.winfavorites.html; classtype:pup-activity; sid:2001705; rev:12; metadata:attack_target Client_Endpoint, created_at 2010_07_30, deployment Perimeter, signature_severity Minor, updated_at 2024_03_17, mitre_tactic_id TA0009, mitre_tactic_name Collection, mitre_technique_id T1005, mitre_technique_name Data_from_local_system;)