alert tls $EXTERNAL_NET any -> $HOME_NET any (msg:"ET INFO Default PolarSSL/mbedTLS Certificate Issuer Observed in Certificate M2"; flow:established,to_client; tls.cert_issuer; bsize:35; content:"C=NL,O=PolarSSL,CN=PolarSSL Test CA"; fast_pattern; reference:url,os.mbed.com/teams/Arcola/code/mbedtls//file/bbdeda018a3c/tests/data_files/Readme-x509.txt/; reference:url,blog.sekoia.io/polaredge-unveiling-an-uncovered-iot-botnet/; classtype:misc-activity; sid:2063690; rev:1; metadata:affected_product IoT, attack_target IoT, created_at 2025_07_24, deployment Perimeter, performance_impact Significant, confidence High, signature_severity Informational, tag mbedTLS, tag PolarSSL, updated_at 2025_07_24;)