alert http any any -> $HOME_NET any (msg:"ET WEB_SPECIFIC_APPS Asus RT get_wan_status multiple parameters Buffer Overflow Attempt"; flow:established,to_server; http.method; content:"POST"; http.uri; bsize:36; content:"/get_wan_status.asp/update_variables"; fast_pattern; http.request_body; pcre:"/(?:wan_proto|rt_ssid|get_wan_status)[^&]{100,}(?:&|$)/"; reference:url,github.com/lafdrew/IOT; classtype:web-application-attack; sid:2063534; rev:1; metadata:affected_product Asus, attack_target Networking_Equipment, tls_state plaintext, created_at 2025_07_16, deployment Perimeter, deployment Internal, performance_impact Low, confidence High, signature_severity Major, tag Exploit, updated_at 2025_07_16, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public_Facing_Application; target:dest_ip;)