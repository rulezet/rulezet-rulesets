alert http $EXTERNAL_NET any -> $HTTP_SERVERS any (msg:"ET INFO ApacheBenchmark Tool User-Agent Detected"; flow:established,to_server; http.user_agent; content:"ApacheBench"; startswith; nocase; threshold:type limit, count 1, seconds 60, track by_src; reference:url,httpd.apache.org/docs/2.0/programs/ab.html/; classtype:attempted-recon; sid:2010725; rev:11; metadata:created_at 2010_07_30, confidence High, signature_severity Informational, updated_at 2024_03_12;)