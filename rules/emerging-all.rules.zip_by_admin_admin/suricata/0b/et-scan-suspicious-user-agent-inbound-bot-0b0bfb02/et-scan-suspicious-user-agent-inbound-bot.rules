alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET SCAN Suspicious User-Agent inbound (bot)"; flow:established,to_server; http.user_agent; content:"bot/"; startswith; nocase; threshold:type limit, count 3, seconds 300, track by_src; classtype:trojan-activity; sid:2008228; rev:13; metadata:affected_product Any, attack_target Client_Endpoint, created_at 2010_07_30, deployment Perimeter, confidence High, signature_severity Major, tag User_Agent, updated_at 2024_03_12;)