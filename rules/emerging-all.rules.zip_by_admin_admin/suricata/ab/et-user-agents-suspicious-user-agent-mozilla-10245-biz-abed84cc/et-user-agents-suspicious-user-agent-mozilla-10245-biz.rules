alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"ET USER_AGENTS Suspicious User-Agent (Mozilla 1.02.45 biz)"; flow:established,to_server; threshold:type limit,count 2,track by_src,seconds 300; http.header; content:"|20|biz|0d 0a|"; within:15; http.user_agent; content:"Mozilla|20|"; startswith; classtype:trojan-activity; sid:2008231; rev:13; metadata:affected_product Any, attack_target Client_Endpoint, created_at 2010_07_30, deployment Perimeter, confidence High, signature_severity Major, tag User_Agent, updated_at 2024_04_13;)