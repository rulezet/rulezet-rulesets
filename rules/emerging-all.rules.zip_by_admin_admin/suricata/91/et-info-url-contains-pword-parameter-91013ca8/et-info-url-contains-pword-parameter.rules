alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"ET INFO URL Contains pword Parameter"; flow:established,to_server; http.uri; content:"pword="; nocase; pcre:"/(?<=(\?|&))pword=(?!&)/i"; classtype:policy-violation; sid:2012917; rev:3; metadata:created_at 2011_06_01, confidence High, signature_severity Informational, updated_at 2024_03_15;)