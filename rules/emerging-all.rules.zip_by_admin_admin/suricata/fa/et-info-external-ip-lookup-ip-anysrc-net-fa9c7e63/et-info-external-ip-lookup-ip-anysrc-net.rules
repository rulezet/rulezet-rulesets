alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"ET INFO External IP Lookup (ip .anysrc .net)"; flow:established,to_server; http.host; content:"ip"; startswith; content:".anysrc.net"; fast_pattern; endswith; classtype:external-ip-check; sid:2039563; rev:1; metadata:affected_product Any, attack_target Client_Endpoint, created_at 2022_10_25, deployment Perimeter, performance_impact Low, confidence High, signature_severity Informational, updated_at 2022_10_25, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1590, mitre_technique_name Gather_Victim_Network_Information;)