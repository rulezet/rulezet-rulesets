alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"ET INFO Possible Ecard Trojan download"; flow:established,to_server; http.uri; content:".exe"; endswith; nocase; pcre:"/(?:gif|car(d|tao)|jpe?g)\.exe$/i"; classtype:suspicious-filename-detect; sid:2006434; rev:10; metadata:created_at 2010_07_30, deployment Perimeter, deprecation_reason Age, confidence Low, signature_severity Informational, updated_at 2024_03_17;)