alert dns $HOME_NET any -> any any (msg:"ET HUNTING IPFS Gateway Domain in DNS Lookup (gateway .pinata .cloud)"; dns.query; dotprefix; content:".gateway.pinata.cloud"; nocase; endswith; reference:url,ipfs.github.io/public-gateway-checker/; reference:url,unit42.paloaltonetworks.com/ipfs-used-maliciously/; classtype:misc-activity; sid:2045144; rev:1; metadata:affected_product Any, attack_target Client_Endpoint, created_at 2023_04_21, deployment Perimeter, performance_impact Low, confidence High, signature_severity Informational, updated_at 2023_04_21, reviewed_at 2023_08_21;)