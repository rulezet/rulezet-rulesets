alert http1 $EXTERNAL_NET any -> $HOME_NET any (msg:"ET CURRENT_EVENTS NuclearPack - PDF Naming Algorithm"; flow:established,to_client; http.header; content:"-Disposition|3a| inline"; nocase; content:".pdf"; pcre:"/=\w{8}\.pdf/i"; file.data; content:"%PDF"; fast_pattern; startswith; content:"/Filter/FlateDecode"; classtype:trojan-activity; sid:2014914; rev:8; metadata:affected_product Windows_XP_Vista_7_8_10_Server_32_64_Bit, attack_target Client_Endpoint, created_at 2012_06_16, deployment Perimeter, malware_family Nuclear, signature_severity Critical, tag Exploit_Kit, tag Nuclear, updated_at 2024_05_06;)