alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"ET INFO Observed DNS Over HTTPS Domain in TLS SNI (dns-family .esegece .com)"; flow:established,to_server; tls.sni; bsize:22; content:"dns-family.esegece.com"; fast_pattern; reference:url,github.com/curl/curl/wiki/DNS-over-HTTPS; classtype:misc-activity; sid:2043425; rev:3; metadata:created_at 2023_01_23, deployment Perimeter, performance_impact Low, confidence High, signature_severity Informational, tag SSL_Malicious_Cert, tag DoH, tag Description_Generated_By_Proofpoint_Nexus, updated_at 2024_12_01, mitre_tactic_id TA0011, mitre_tactic_name Command_And_Control, mitre_technique_id T1572, mitre_technique_name Protocol_Tunneling;)