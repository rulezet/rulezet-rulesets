alert http $EXTERNAL_NET any -> $HTTP_SERVERS any (msg:"ET WEB_SPECIFIC_APPS myBloggie SQL Injection Attempt -- index.php cat_id UNION SELECT"; flow:established,to_server; http.uri; content:"/index.php?"; nocase; content:"cat_id="; fast_pattern; nocase; content:"UPDATE"; nocase; pcre:"/UPDATE\s+SELECT/i"; reference:cve,CVE-2007-3003; reference:url,www.securityfocus.com/bid/24249; classtype:web-application-attack; sid:2004469; rev:7; metadata:affected_product Web_Server_Applications, attack_target Web_Server, created_at 2010_07_30, deployment Datacenter, confidence Medium, signature_severity Major, tag SQL_Injection, updated_at 2024_03_19, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public_Facing_Application;)