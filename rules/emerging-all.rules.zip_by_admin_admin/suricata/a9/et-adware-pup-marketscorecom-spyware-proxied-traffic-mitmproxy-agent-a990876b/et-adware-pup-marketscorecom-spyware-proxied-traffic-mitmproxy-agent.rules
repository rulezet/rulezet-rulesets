alert http1 $HOME_NET any -> $EXTERNAL_NET any (msg:"ET ADWARE_PUP MarketScore.com Spyware Proxied Traffic (mitmproxy agent)"; flow:established,to_server; http.header; content:"Proxy-agent|3a 20|ManInTheMiddle-Proxy"; nocase; reference:url,www.marketscore.com; reference:url,www.spysweeper.com/remove-marketscore.html; classtype:pup-activity; sid:2001586; rev:12; metadata:created_at 2010_07_30, signature_severity Minor, updated_at 2024_04_11;)