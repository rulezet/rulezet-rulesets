alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"ET ADWARE_PUP SpyDawn.com Fake Anti-Spyware User-Agent (SpyDawn)"; flow:established,to_server; http.user_agent; content:"SpyDawn"; nocase; startswith; endswith; reference:url,www.spywareguide.com/spydet_3366_spydawn.html; classtype:pup-activity; sid:2003499; rev:14; metadata:attack_target Client_Endpoint, created_at 2010_07_30, deployment Perimeter, confidence High, signature_severity Minor, tag Spyware_User_Agent, updated_at 2024_04_13;)