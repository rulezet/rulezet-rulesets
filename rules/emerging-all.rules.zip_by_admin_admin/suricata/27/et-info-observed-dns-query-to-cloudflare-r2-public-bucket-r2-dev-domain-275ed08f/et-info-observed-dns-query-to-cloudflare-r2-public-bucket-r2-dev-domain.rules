alert dns $HOME_NET any -> any any (msg:"ET INFO Observed DNS Query to Cloudflare R2 Public Bucket (r2 .dev) Domain"; dns.query; dotprefix; content:".r2.dev"; nocase; endswith; pcre:"/pub\x2d[a-f0-9]{32}\x2er2\x2edev/"; reference:url,developers.cloudflare.com/r2/buckets/public-buckets/; classtype:trojan-activity; sid:2062570; rev:1; metadata:attack_target Client_Endpoint, created_at 2025_05_27, deployment Perimeter, confidence High, signature_severity Major, tag AI_Generated_Description, updated_at 2025_05_27; target:src_ip;)