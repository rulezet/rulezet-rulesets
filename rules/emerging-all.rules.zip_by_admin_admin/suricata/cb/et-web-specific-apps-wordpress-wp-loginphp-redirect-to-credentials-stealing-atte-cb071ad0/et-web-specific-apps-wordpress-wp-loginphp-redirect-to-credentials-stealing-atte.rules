alert http $EXTERNAL_NET any -> $HTTP_SERVERS any (msg:"ET WEB_SPECIFIC_APPS Wordpress wp-login.php redirect_to credentials stealing attempt"; flow:established,to_server; http.uri; content:"/wp-login.php"; nocase; content:"redirect_to"; fast_pattern; pcre:"/redirect_to=(ht|f)tps?\:\//i"; reference:url,www.inliniac.net/blog/?p=71; classtype:web-application-attack; sid:2003508; rev:8; metadata:affected_product Wordpress, affected_product Wordpress_Plugins, attack_target Web_Server, created_at 2010_07_30, deployment Datacenter, signature_severity Major, tag Wordpress, updated_at 2024_03_16;)