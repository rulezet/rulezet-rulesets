alert http $EXTERNAL_NET any -> $HTTP_SERVERS any (msg:"ET WEB_SPECIFIC_APPS ProdLer prodler.class.php sPath Parameter Remote File Inclusion Attempt"; flow:established,to_server; http.uri; content:"/include/prodler.class.php?"; nocase; content:"sPath="; nocase; pcre:"/sPath\s*=\s*(https?|ftps?|php)\:\//i"; reference:url,osvdb.org/show/osvdb/58298; classtype:web-application-attack; sid:2010276; rev:6; metadata:created_at 2010_07_30, signature_severity Major, updated_at 2024_03_06, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public_Facing_Application;)