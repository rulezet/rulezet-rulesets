alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"ET INFO External IP Lookup ipinfo.io"; flow:established,to_server; http.host; content:"ipinfo.io"; startswith; endswith; fast_pattern; http.header_names; to_lowercase; content:!"|0d 0a|referer|0d 0a|"; classtype:external-ip-check; sid:2020716; rev:10; metadata:attack_target Client_Endpoint, created_at 2015_03_20, deployment Perimeter, performance_impact Low, confidence High, signature_severity Informational, updated_at 2024_11_26, reviewed_at 2024_03_27, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1590, mitre_technique_name Gather_Victim_Network_Information;)