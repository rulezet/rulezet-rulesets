alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"ET DYN_DNS DYNAMIC_DNS HTTP Request to a *.sytes.net Domain"; flow:established,to_server; http.host; content:".sytes.net"; endswith; classtype:bad-unknown; sid:2018219; rev:12; metadata:attack_target Client_and_Server, created_at 2012_03_05, deployment Perimeter, performance_impact Low, confidence High, signature_severity Informational, updated_at 2024_12_01, reviewed_at 2024_03_19, mitre_tactic_id TA0011, mitre_tactic_name Command_And_Control, mitre_technique_id T1568, mitre_technique_name Dynamic_Resolution;)