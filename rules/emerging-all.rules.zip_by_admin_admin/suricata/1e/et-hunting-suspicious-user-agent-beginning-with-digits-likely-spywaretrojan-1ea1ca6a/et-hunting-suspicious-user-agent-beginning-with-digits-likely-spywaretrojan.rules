alert http $HOME_NET any -> $EXTERNAL_NET $HTTP_PORTS (msg:"ET HUNTING Suspicious User-Agent Beginning with digits - Likely spyware/trojan"; flow:established,to_server; http.header_names; to_lowercase; content:"|0d 0a|user-agent|0d 0a|"; fast_pattern; http.user_agent; content:!"Mozilla/"; pcre:"/^\d+/"; http.host; content:!"liveupdate.symantecliveupdate.com"; classtype:trojan-activity; sid:2010697; rev:11; metadata:affected_product Any, attack_target Client_Endpoint, created_at 2010_07_30, deployment Perimeter, deprecation_reason Performance, performance_impact Significant, confidence Medium, signature_severity Major, tag User_Agent, updated_at 2024_05_06;)