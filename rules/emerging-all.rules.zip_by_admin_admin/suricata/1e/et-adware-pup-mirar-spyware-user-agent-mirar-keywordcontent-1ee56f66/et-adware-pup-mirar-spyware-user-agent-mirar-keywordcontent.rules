alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"ET ADWARE_PUP Mirar Spyware User-Agent (Mirar_KeywordContent)"; flow:established,to_server; http.user_agent; content:"Mirar_KeywordContent"; nocase; startswith; endswith; reference:url,www3.ca.com/securityadvisor/pest/pest.aspx?id=453078818; classtype:pup-activity; sid:2003490; rev:13; metadata:attack_target Client_Endpoint, created_at 2010_07_30, deployment Perimeter, confidence High, signature_severity Minor, tag Spyware_User_Agent, updated_at 2024_04_13;)