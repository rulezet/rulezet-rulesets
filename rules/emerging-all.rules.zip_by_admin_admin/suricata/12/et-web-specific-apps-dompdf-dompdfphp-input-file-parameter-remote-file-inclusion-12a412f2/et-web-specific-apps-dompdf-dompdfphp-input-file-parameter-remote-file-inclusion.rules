alert http $EXTERNAL_NET any -> $HTTP_SERVERS any (msg:"ET WEB_SPECIFIC_APPS Dompdf dompdf.php input_file Parameter Remote File Inclusion Attempt"; flow:established,to_server; http.method; content:"GET"; http.uri; content:"/dompdf.php?"; nocase; content:"input_file="; nocase; pcre:"/input_file=\s*(ftps?|https?|php)\:\//i"; reference:url,exploit-db.com/exploits/14851/; classtype:web-application-attack; sid:2011565; rev:4; metadata:created_at 2010_09_27, signature_severity Major, updated_at 2020_09_10, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public_Facing_Application;)