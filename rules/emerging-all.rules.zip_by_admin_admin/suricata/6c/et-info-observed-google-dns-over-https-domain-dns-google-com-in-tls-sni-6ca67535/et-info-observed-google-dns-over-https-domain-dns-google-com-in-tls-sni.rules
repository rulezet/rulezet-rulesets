alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"ET INFO Observed Google DNS over HTTPS Domain (dns .google .com in TLS SNI)"; flow:established,to_server; threshold: type both, track by_src, count 1, seconds 600; tls.sni; content:"dns.google.com"; startswith; endswith; reference:url,developers.google.com/speed/public-dns/docs/doh/; classtype:misc-activity; sid:2046071; rev:4; metadata:affected_product Any, attack_target Client_Endpoint, created_at 2019_08_21, deployment Perimeter, performance_impact Low, confidence High, signature_severity Informational, tag DoH, updated_at 2024_04_13, former_sid 2838110;)