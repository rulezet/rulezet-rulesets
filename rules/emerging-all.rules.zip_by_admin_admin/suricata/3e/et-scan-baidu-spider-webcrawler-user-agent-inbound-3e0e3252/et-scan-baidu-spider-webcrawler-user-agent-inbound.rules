alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET SCAN Baidu Spider Webcrawler User Agent - inbound"; flow:established,to_server; http.user_agent; content:"baiduspider"; nocase; classtype:not-suspicious; sid:2033338; rev:7; metadata:attack_target Web_Server, created_at 2021_05_19, deployment Perimeter, performance_impact Low, confidence High, signature_severity Informational, tag WebCrawler, updated_at 2024_03_18, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1593, mitre_technique_name Search_Open_Websites;)