alert tls $EXTERNAL_NET any -> $HOME_NET any (msg:"ET INFO Observed SSL Cert (URL Shortener Service - tiny .cc)"; flow:established,to_client; tls.cert_subject; content:"CN=tiny.cc"; nocase; endswith; tls.cert_issuer; content:"C=US, O=Let's Encrypt, CN=Let's Encrypt Authority X3"; classtype:misc-activity; sid:2027200; rev:6; metadata:created_at 2019_04_15, confidence High, signature_severity Informational, tag URL_Shortener_Service, updated_at 2024_03_07;)