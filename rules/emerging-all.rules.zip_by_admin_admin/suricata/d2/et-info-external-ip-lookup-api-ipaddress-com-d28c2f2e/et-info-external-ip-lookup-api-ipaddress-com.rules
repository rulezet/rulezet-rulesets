alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"ET INFO External IP Lookup (api .ipaddress .com)"; flow:established,to_server; http.method; content:"GET"; http.uri; content:"/myip"; startswith; endswith; http.host; content:"api.ipaddress.com"; startswith; fast_pattern; endswith; classtype:external-ip-check; sid:2027905; rev:4; metadata:attack_target Client_Endpoint, created_at 2019_08_22, deployment Perimeter, performance_impact Low, confidence High, signature_severity Informational, tag IP_address_lookup_website, updated_at 2024_04_13, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1590, mitre_technique_name Gather_Victim_Network_Information;)