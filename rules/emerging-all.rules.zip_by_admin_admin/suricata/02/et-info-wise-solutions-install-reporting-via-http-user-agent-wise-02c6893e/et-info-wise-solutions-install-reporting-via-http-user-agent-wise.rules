alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"ET INFO Wise Solutions Install Reporting via HTTP - User Agent (Wise)"; flow:established,to_server; http.user_agent; content:"Wise"; startswith; reference:url,www3.ca.com/securityadvisor/pest/pest.aspx?id=453076771; reference:url,en.wikipedia.org/wiki/Wise_Solutions; classtype:misc-activity; sid:2002167; rev:20; metadata:attack_target Client_Endpoint, created_at 2010_07_30, deployment Perimeter, performance_impact Low, confidence Medium, signature_severity Informational, updated_at 2023_05_16, reviewed_at 2024_05_02; target:src_ip;)