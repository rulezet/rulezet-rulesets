alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET WEB_SPECIFIC_APPS Joomla component com_jinc (newsid) Blind SQL Injection Attempt"; flow:established,to_server; http.uri; content:"option=com_jinc"; nocase; content:"newsid="; nocase; content:"index.php?"; nocase; pcre:"/newsid=[^\s\x26\x3B\x2f]*[\s\x2f]/i"; reference:url,milw0rm.org/exploits/9732; classtype:web-application-attack; sid:2010529; rev:6; metadata:affected_product Web_Server_Applications, attack_target Web_Server, created_at 2010_07_30, deployment Datacenter, signature_severity Major, tag SQL_Injection, updated_at 2020_09_11, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public_Facing_Application;)