alert http $EXTERNAL_NET any -> $HTTP_SERVERS any (msg:"ET WEB_SPECIFIC_APPS phptraverse mp3_id.php GLOBALS Parameter Remote File Inclusion Attempt"; flow:established,to_server; http.method; content:"GET"; http.uri; content:"/assets/plugins/mp3_id/mp3_id.php?"; nocase; content:"GLOBALS[BASE]="; nocase; pcre:"/GLOBALS\[BASE\]\s*=\s*(https?|ftps?|php)\:\//i"; reference:url,www.packetstormsecurity.nl/0911-exploits/phptraverse-rfi.txt; classtype:web-application-attack; sid:2010485; rev:6; metadata:created_at 2010_07_30, signature_severity Major, updated_at 2024_03_06, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public_Facing_Application;)