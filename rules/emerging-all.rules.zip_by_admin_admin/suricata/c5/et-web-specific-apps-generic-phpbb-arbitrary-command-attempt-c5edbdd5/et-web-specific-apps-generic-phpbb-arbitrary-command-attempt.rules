alert http $EXTERNAL_NET any -> $HTTP_SERVERS any (msg:"ET WEB_SPECIFIC_APPS Generic phpbb arbitrary command attempt"; flow:established,to_server; http.uri; content:".php?"; nocase; content:"phpbb_root_path="; fast_pattern; nocase; pcre:"/phpbb_root_path=(ftps?|https?|php)/i"; reference:url,cve.mitre.org/cgi-bin/cvekey.cgi?keyword=phpbb_root_path; classtype:web-application-attack; sid:2002731; rev:10; metadata:created_at 2010_07_30, confidence Medium, signature_severity Major, updated_at 2024_03_19;)