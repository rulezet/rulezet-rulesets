alert http1 $HOME_NET any -> $EXTERNAL_NET any (msg:"ET HUNTING Suspicious exe.exe request - possible downloader/Oficla"; flow:established,to_server; http.request_line; content:"/exe.exe HTTP/1."; nocase; reference:url,anubis.iseclab.org/?action=result&task_id=11873c8979f34c8d4fd0da512df635cac&format=txt; classtype:trojan-activity; sid:2010741; rev:7; metadata:created_at 2010_07_30, confidence Medium, signature_severity Major, updated_at 2024_04_10;)