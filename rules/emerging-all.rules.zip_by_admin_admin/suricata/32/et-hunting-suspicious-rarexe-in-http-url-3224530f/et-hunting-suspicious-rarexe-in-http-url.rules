alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"ET HUNTING SUSPICIOUS *.rar.exe in HTTP URL"; flow:established,to_server; http.uri; content:".rar.exe"; fast_pattern; nocase; endswith; classtype:bad-unknown; sid:2020386; rev:5; metadata:created_at 2015_02_09, confidence Medium, signature_severity Informational, updated_at 2024_03_06;)