alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"ET INFO Observed External IP Lookup Domain (geoipy .com) in TLS SNI"; flow:established,to_server; tls.sni; dotprefix; content:".geoipy.com"; endswith; fast_pattern; reference:url,github.com/SigmaHQ/sigma/blob/master/rules/windows/dns_query/dns_query_win_susp_external_ip_lookup.yml; classtype:misc-activity; sid:2063064; rev:1; metadata:affected_product Any, attack_target Client_and_Server, created_at 2025_06_18, deployment Perimeter, performance_impact Low, confidence High, signature_severity Informational, updated_at 2025_06_18;)