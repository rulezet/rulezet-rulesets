alert http $EXTERNAL_NET any -> $HTTP_SERVERS any (msg:"ET WEB_SPECIFIC_APPS Wordpress Plugin Tinymce Thumbnail Gallery href parameter Remote File Disclosure Attempt"; flow:established,to_server; http.uri; content:"/wp-content/plugins/tinymce-thumbnail-gallery/php/download-image.php?"; nocase; fast_pattern; content:"href="; nocase; http.uri.raw; url_decode; content:"|2e 2e 2f|"; reference:url,packetstormsecurity.org/files/113417/WordPress-Tinymce-Thumbnail-Gallery-1.0.7-File-Disclosure.html; classtype:web-application-attack; sid:2014899; rev:8; metadata:affected_product Wordpress, affected_product Wordpress_Plugins, attack_target Web_Server, created_at 2012_06_15, deployment Datacenter, signature_severity Major, tag Wordpress, updated_at 2024_04_08;)