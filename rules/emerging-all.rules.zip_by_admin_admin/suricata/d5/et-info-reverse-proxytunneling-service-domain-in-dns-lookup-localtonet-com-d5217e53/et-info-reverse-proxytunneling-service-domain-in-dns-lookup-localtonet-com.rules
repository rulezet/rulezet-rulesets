alert dns $HOME_NET any -> any any (msg:"ET INFO Reverse Proxy/Tunneling Service Domain in DNS Lookup (localtonet .com)"; dns.query; dotprefix; content:".localtonet.com"; nocase; endswith; reference:url,github.com/SigmaHQ/sigma/blob/master/rules/linux/network_connection/net_connection_lnx_domain_localtonet_tunnel.yml; classtype:misc-activity; sid:2063131; rev:1; metadata:affected_product Any, attack_target Client_and_Server, created_at 2025_06_23, deployment Perimeter, performance_impact Low, confidence High, signature_severity Informational, updated_at 2025_06_23, mitre_tactic_id TA0011, mitre_tactic_name Command_And_Control, mitre_technique_id T1665, mitre_technique_name Hide_Infrastructure;)