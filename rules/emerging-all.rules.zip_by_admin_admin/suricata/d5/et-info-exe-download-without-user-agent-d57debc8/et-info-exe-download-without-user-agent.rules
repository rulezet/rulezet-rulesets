alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"ET INFO exe download without User Agent"; flow:established,to_server; http.method; content:"GET"; http.uri; content:".exe"; endswith; nocase; http.header_names; to_lowercase; content:!"|0d 0a|user-agent|0d 0a|"; http.host; content:!"download.windowsupdate.com"; classtype:policy-violation; sid:2003179; rev:12; metadata:created_at 2010_07_30, confidence High, signature_severity Informational, updated_at 2024_04_27;)