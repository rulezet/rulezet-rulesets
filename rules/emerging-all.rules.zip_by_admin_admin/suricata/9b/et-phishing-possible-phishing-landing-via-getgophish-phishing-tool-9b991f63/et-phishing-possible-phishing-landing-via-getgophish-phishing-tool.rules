alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"ET PHISHING Possible Phishing Landing via GetGoPhish Phishing Tool"; flow:established,to_server; http.method; content:"GET"; http.uri; content:"?rid="; fast_pattern; pcre:"/\?rid=[a-f0-9]{64}$/i"; http.host; content:!"xerox.com"; endswith; reference:url,getgophish.com; classtype:social-engineering; sid:2022486; rev:7; metadata:attack_target Client_Endpoint, created_at 2016_02_03, deployment Perimeter, deprecation_reason Age, confidence Low, signature_severity Critical, tag Phishing, updated_at 2024_04_19, reviewed_at 2024_04_19, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1566, mitre_technique_name Phishing;)