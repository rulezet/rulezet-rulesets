alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"ET DYN_DNS DYNAMIC_DNS HTTP Request to a *.pelshare .com .au domain"; flow:established,to_server; http.host; content:".pelshare.com.au"; endswith; fast_pattern; reference:url,freedns.afraid.org/domain/registry/page-5.html; classtype:bad-unknown; sid:2060238; rev:1; metadata:attack_target Client_and_Server, created_at 2025_02_20, deployment Perimeter, confidence High, signature_severity Informational, updated_at 2025_02_20, mitre_tactic_id TA0011, mitre_tactic_name Command_And_Control, mitre_technique_id T1568, mitre_technique_name Dynamic_Resolution;)