alert http $EXTERNAL_NET any -> $HTTP_SERVERS any (msg:"ET WEB_SPECIFIC_APPS WebSense Email security msgAnalyse.asp ServerName XSS Attempt"; flow:established,to_server; http.uri; content:"/web/msgList/viewmsg/actions/msgAnalyse.asp?"; nocase; content:"ServerName="; nocase; pcre:"/ServerName\s*=[\x22\x27\x3c\x3e\x20]*(script|img|src|onmouse|onkey|onload|ondragdrop|onblur|onfocus|onclick)/i"; reference:url,www.securityfocus.com/bid/36741/; classtype:web-application-attack; sid:2010173; rev:5; metadata:created_at 2010_07_30, signature_severity Major, updated_at 2020_09_09;)