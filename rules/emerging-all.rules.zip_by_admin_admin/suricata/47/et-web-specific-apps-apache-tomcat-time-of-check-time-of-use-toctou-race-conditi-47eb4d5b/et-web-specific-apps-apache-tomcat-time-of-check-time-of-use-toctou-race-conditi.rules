alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET WEB_SPECIFIC_APPS Apache Tomcat Time-of-check Time-of-use (TOCTOU) Race Condition during JSP Compilation (CVE-2024-50379)"; flow:established,to_server; http.method; content:"PUT"; http.uri; content:".jsp"; endswith; nocase; http.content_type; content:"application/json"; http.request_body; content:"|3c 25|"; startswith; content:"|2e|exec|28|"; fast_pattern; threshold:type both,track by_src, count 300, seconds 60; reference:url,github.com/ph0ebus/Tomcat-CVE-2024-50379-Poc; reference:cve,2024-50379; classtype:web-application-attack; sid:2059684; rev:1; metadata:affected_product Apache_Tomcat, attack_target Server, tls_state TLSDecrypt, created_at 2025_01_27, deployment Perimeter, deployment Internal, deployment SSLDecrypt, performance_impact Significant, confidence High, signature_severity Major, tag Exploit, updated_at 2025_01_27, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public_Facing_Application; target:dest_ip;)