alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"ET HUNTING Invalid User-Agent - MSIE 9 on Windows NT 5"; flow:established,to_server; threshold: type limit,track by_src,count 2,seconds 60; http.user_agent; content:" MSIE 9.0|3b| Windows NT 5."; fast_pattern; reference:url,windows.microsoft.com/en-us/internet-explorer/products/ie-9/system-requirements; classtype:bad-unknown; sid:2016897; rev:9; metadata:created_at 2013_05_21, confidence Medium, signature_severity Informational, updated_at 2022_06_27;)