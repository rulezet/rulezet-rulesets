alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"ET USER_AGENTS Suspicious User-Agent (InetURL)"; flow:established,to_server; http.user_agent; content:"InetURL"; startswith; http.host; content:!"www.dell.com"; content:!"pdfmachine.com"; content:!"gs.apple.com"; threshold: type limit, count 2, track by_src, seconds 300; classtype:trojan-activity; sid:2008374; rev:16; metadata:affected_product Any, attack_target Client_Endpoint, created_at 2010_07_30, deployment Perimeter, confidence High, signature_severity Informational, tag User_Agent, updated_at 2024_02_07;)