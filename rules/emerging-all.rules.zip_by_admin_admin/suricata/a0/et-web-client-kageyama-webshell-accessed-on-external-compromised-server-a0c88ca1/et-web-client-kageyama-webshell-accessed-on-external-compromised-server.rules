alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET WEB_CLIENT Kageyama Webshell Accessed on External Compromised Server"; flow:established,to_client; file.data; content:"<H1><center>Shell Kageyama</center></H1>"; nocase; fast_pattern; classtype:web-application-attack; sid:2029871; rev:2; metadata:affected_product Web_Server_Applications, attack_target Web_Server, created_at 2020_04_10, deployment Perimeter, confidence High, signature_severity Major, updated_at 2020_04_10;)