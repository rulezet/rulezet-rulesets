alert http $EXTERNAL_NET any -> $HTTP_SERVERS any (msg:"ET WEB_SPECIFIC_APPS PHP Gnopaster Common.php remote file include"; flow:established,to_server; http.uri; content:"/includes/common.php"; fast_pattern; nocase; pcre:"/root_path=\s*(ftps?|https?|php)\:\//i"; reference:bugtraq,18180; classtype:web-application-attack; sid:2003333; rev:8; metadata:affected_product Any, attack_target Server, created_at 2010_07_30, deployment Datacenter, signature_severity Major, tag Remote_File_Include, updated_at 2024_03_11, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public_Facing_Application;)