alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"ET USER_AGENTS Suspicious User-Agent (dwplayer)"; flow:established,to_server; http.user_agent; content:"dwplayer"; startswith; threshold: type limit, count 2, track by_src, seconds 300; classtype:policy-violation; sid:2008489; rev:10; metadata:affected_product Any, attack_target Client_Endpoint, created_at 2010_07_30, deployment Perimeter, confidence High, signature_severity Informational, tag User_Agent, updated_at 2024_02_15;)