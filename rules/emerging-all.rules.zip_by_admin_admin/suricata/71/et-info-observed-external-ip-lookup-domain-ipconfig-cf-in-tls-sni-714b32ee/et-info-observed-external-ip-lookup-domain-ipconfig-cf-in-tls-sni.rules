alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"ET INFO Observed External IP Lookup Domain (ipconfig .cf in TLS SNI)"; flow:established,to_server; tls.sni; content:"ipconfig.cf"; endswith; classtype:external-ip-check; sid:2027919; rev:3; metadata:attack_target Client_Endpoint, created_at 2019_08_26, deployment Perimeter, performance_impact Low, confidence High, signature_severity Informational, tag IP_address_lookup_website, updated_at 2020_09_17, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1590, mitre_technique_name Gather_Victim_Network_Information;)