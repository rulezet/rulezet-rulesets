alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"ET ADWARE_PUP Executable purporting to be .cfg file with no Referer - Likely Malware"; flow:established,to_server; flowbits:set,ET.hidden.exe; flowbits:noalert; http.method; content:"GET"; nocase; http.uri; content:".cfg"; fast_pattern; endswith; nocase; http.header_names; to_lowercase; content:!"|0d 0a|referer|0d 0a|"; nocase; reference:url,www.symantec.com/security_response/writeup.jsp?docid=2009-072313-3630-99; classtype:pup-activity; sid:2010501; rev:9; metadata:created_at 2010_07_30, confidence Medium, signature_severity Minor, updated_at 2024_04_27;)