alert http any any -> $HOME_NET any (msg:"ET WEB_SPECIFIC_APPS Microsoft Exchange OWA Authenticated Server-Side Request Forgery (ZDI-CAN-22101) M1"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/owa/service.svc|3f|action|3d|createattachmentfromuri"; fast_pattern; startswith; nocase; http.request_body; content:"createattachmentfromurirequestwrapper"; nocase; pcre:"/^[^\x0d\x0a]*?(?:\x22|\x2522)[uU][rR][iIlL](?:\x22|\x2522)(?:\x3a|\x253[aA])/R"; reference:url,www.zerodayinitiative.com/blog/2023/11/1/unpatched-powerful-ssrf-in-exchange-owa-getting-response-through-attachments; classtype:web-application-attack; sid:2063624; rev:1; metadata:affected_product Microsoft_Exchange, attack_target Server, tls_state TLSDecrypt, created_at 2025_07_21, deployment Perimeter, deployment Internal, confidence High, signature_severity Major, tag Exploit, updated_at 2025_07_21, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public_Facing_Application; target:dest_ip;)