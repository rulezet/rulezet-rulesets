alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"ET USER_AGENTS Suspicious User-Agent (Loands) - Possible Trojan Downloader GET Request"; flow:established,to_server; http.user_agent; bsize:6; content:"Loands"; threshold: type limit, count 2, track by_src, seconds 300; classtype:trojan-activity; sid:2009537; rev:10; metadata:affected_product Any, attack_target Client_Endpoint, created_at 2010_07_30, deployment Perimeter, confidence Medium, signature_severity Major, tag User_Agent, tag Trojan_Downloader, updated_at 2024_04_11;)