alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"ET INFO localtunnel Reverse Proxy Domain (localtunnel .me in TLS SNI)"; flow:established,to_server; tls.sni; content:".localtunnel.me"; endswith; nocase; reference:url,localtunnel.github.io/www/; classtype:policy-violation; sid:2025139; rev:4; metadata:created_at 2017_12_06, confidence High, signature_severity Informational, updated_at 2020_09_16;)