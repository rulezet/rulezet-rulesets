alert http $EXTERNAL_NET any -> $HTTP_SERVERS any (msg:"ET WEB_SPECIFIC_APPS Jetbox CMS SQL Injection Attempt -- index.php login UPDATE"; flow:established,to_server; http.uri; content:"/index.php?"; nocase; content:"login="; nocase; content:"UPDATE"; fast_pattern; nocase; pcre:"/UPDATE.+SET/i"; reference:cve,CVE-2007-2685; reference:url,www.netvigilance.com/advisory0028; classtype:web-application-attack; sid:2003974; rev:9; metadata:affected_product Web_Server_Applications, attack_target Web_Server, created_at 2010_07_30, deployment Datacenter, confidence Medium, signature_severity Major, tag SQL_Injection, updated_at 2024_03_11, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public_Facing_Application;)