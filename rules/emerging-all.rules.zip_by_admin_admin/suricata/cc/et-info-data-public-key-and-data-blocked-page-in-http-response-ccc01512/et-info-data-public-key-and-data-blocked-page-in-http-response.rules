alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET INFO Data-Public-Key and Data-Blocked-Page in HTTP Response"; flow:established,to_client; http.stat_code; content:"200"; http.response_body; content:"|3c|script|20|defer|20|data-public-key|3d|"; fast_pattern; pcre:"/^(?:\x22|\x27)[A-Za-z0-9]{32}/R"; content:"data-blocked-page|3d|"; within:100; classtype:misc-activity; sid:2060655; rev:1; metadata:affected_product Any, tls_state TLSDecrypt, created_at 2025_03_06, deployment Perimeter, performance_impact Low, confidence Medium, signature_severity Minor, updated_at 2025_03_06, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1566, mitre_technique_name Phishing; target:dest_ip;)