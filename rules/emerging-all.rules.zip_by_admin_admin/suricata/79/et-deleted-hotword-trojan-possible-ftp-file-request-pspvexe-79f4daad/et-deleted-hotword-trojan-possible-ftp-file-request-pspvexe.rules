alert tcp $HOME_NET any -> $EXTERNAL_NET 21 (msg:"ET DELETED Hotword Trojan - Possible FTP File Request pspv.exe"; flow: to_server,established; content:"SIZE pspv.exe"; reference:url,securityresponse.symantec.com/avcenter/venc/data/trojan.hotword.html; classtype:trojan-activity; sid:2001963; rev:10; metadata:created_at 2010_07_30, signature_severity Unknown, updated_at 2019_07_26;)