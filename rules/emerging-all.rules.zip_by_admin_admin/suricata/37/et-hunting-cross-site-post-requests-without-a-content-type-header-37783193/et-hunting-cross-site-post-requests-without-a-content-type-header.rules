alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET HUNTING Cross-Site POST Requests Without a Content-Type Header"; flow:established,to_server; http.method; content:"POST"; http.header_names; to_lowercase; content:"content-length|0d 0a|"; content:!"content-type|0d 0a|"; http.header; to_lowercase; content:"sec-fetch-site|3a 20|cross-site"; fast_pattern; reference:url,nastystereo.com/security/cross-site-post-without-content-type.html; classtype:web-application-attack; sid:2059760; rev:1; metadata:attack_target Web_Server, tls_state TLSDecrypt, created_at 2025_01_29, deployment Perimeter, deployment SSLDecrypt, confidence Medium, signature_severity Major, updated_at 2025_01_29; target:dest_ip;)