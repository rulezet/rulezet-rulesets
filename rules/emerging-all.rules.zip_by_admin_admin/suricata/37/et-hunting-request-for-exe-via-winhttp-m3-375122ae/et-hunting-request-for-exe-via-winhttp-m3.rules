alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"ET HUNTING Request for EXE via WinHTTP M3"; flow:established,to_server; http.method; content:"GET"; http.uri; content:".exe"; endswith; http.user_agent; content:"WinHttp-Autoproxy-Service/"; startswith; fast_pattern; http.header_names; to_lowercase; content:!"|0d 0a|referer|0d 0a|"; classtype:bad-unknown; sid:2029842; rev:2; metadata:affected_product Windows_XP_Vista_7_8_10_Server_32_64_Bit, attack_target Client_Endpoint, created_at 2020_04_09, deployment Perimeter, confidence Medium, signature_severity Informational, updated_at 2024_04_20;)