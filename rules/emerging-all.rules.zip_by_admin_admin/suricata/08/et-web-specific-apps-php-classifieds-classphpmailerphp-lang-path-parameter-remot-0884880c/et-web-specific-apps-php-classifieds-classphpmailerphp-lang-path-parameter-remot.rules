alert http $EXTERNAL_NET any -> $HTTP_SERVERS any (msg:"ET WEB_SPECIFIC_APPS PHP Classifieds class.phpmailer.php lang_path Parameter Remote File Inclusion Attempt"; flow:established,to_server; http.method; content:"GET"; http.uri; content:"/class.phpmailer.php?"; nocase; content:"lang_path="; nocase; pcre:"/lang_path=\s*(ftps?|https?|php)\:\//i"; reference:url,exploit-db.com/exploits/14893/; classtype:web-application-attack; sid:2011564; rev:4; metadata:created_at 2010_09_27, signature_severity Major, updated_at 2020_09_10, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public_Facing_Application;)