alert http any any -> $HOME_NET any (msg:"ET WEB_SPECIFIC_APPS ABB Cylon Aspect Unauthenticated DeploymentServelet Request Type DeploySource Directory Traversal and Arbitrary File Upload Attempt"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/servelets/DeploymentServlet"; fast_pattern; startswith; content:"RequestType|3d|DeploySource"; content:"filename|3d|"; pcre:"/^[^\x26]*?(?:(?:\x2e|%2[Ee]){1,2}(?:\x2f|\x5c|%5[Cc]|%2[Ff]){1,}){2,}/R"; content:"directory|3d|"; http.host; bsize:9; content:"127.0.0.1"; reference:url,www.zeroscience.mk/codes/abb_aspect_rce28.txt; classtype:web-application-attack; sid:2063894; rev:1; metadata:affected_product ABB, attack_target IoT, tls_state plaintext, created_at 2025_08_04, deployment Perimeter, deployment Internal, performance_impact Low, confidence High, signature_severity Major, tag Exploit, updated_at 2025_08_04, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public_Facing_Application; target:dest_ip;)