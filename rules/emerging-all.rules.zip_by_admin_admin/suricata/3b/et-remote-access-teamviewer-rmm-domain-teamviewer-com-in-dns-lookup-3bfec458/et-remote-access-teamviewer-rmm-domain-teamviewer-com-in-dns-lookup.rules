alert dns $HOME_NET any -> any any (msg:"ET REMOTE_ACCESS TeamViewer RMM Domain (teamviewer .com) in DNS Lookup"; content:!"|03|www"; dns.query; dotprefix; content:".teamviewer.com"; fast_pattern; nocase; endswith; threshold:type limit, seconds 180, count 1, track by_src; reference:url,www.teamviewer.com; classtype:misc-activity; sid:2060630; rev:1; metadata:affected_product Any, attack_target Client_and_Server, created_at 2025_03_05, deployment Perimeter, performance_impact Low, confidence High, signature_severity Informational, tag Teamviewer, tag RMM, updated_at 2025_03_05, mitre_tactic_id TA0011, mitre_tactic_name Command_And_Control, mitre_technique_id T1219, mitre_technique_name Remote_Access_Software;)