alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"ET INFO External IP Lookup - www.ip.cn"; flow:established,to_server; http.host; content:"www.ip.cn"; startswith; endswith; classtype:external-ip-check; sid:2021600; rev:8; metadata:attack_target Client_Endpoint, created_at 2015_08_06, deployment Perimeter, performance_impact Low, confidence High, signature_severity Informational, updated_at 2024_11_26, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1590, mitre_technique_name Gather_Victim_Network_Information;)