alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"ET FILE_SHARING Observed File Sharing Service (acrobat .adobe .com in TLS SNI)"; flow:established,to_server; tls.sni; dotprefix; content:".acrobat.adobe.com"; endswith; fast_pattern; threshold:type limit,count 1,seconds 300,track by_src; classtype:misc-activity; sid:2065193; rev:1; metadata:attack_target Client_Endpoint, created_at 2025_10_14, deployment Perimeter, confidence High, signature_severity Informational, tag TA_Abused_Online_Service, tag File_Sharing, updated_at 2025_10_14;)