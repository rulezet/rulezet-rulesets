alert dns $HOME_NET any -> any any (msg:"ET PHISHING Suspicious TikTok Domain Request - Possible Phishing or Scam"; dns.query; content:"tiktok"; fast_pattern; pcre:"/(?:verify|support|account|copyright|help|verified|service|badge|verification|safety)?.{0,30}tiktok(?:verify|support|account|copyright|help|verified|service|badge|verification|safety)?.{0,30}(\.ml$|\.ga$|\.cf$|\.gq$|\.tk$|\.xyz$)/"; classtype:social-engineering; sid:2031492; rev:3; metadata:attack_target Client_Endpoint, created_at 2021_01_07, deployment Perimeter, confidence Medium, signature_severity Critical, tag Phishing, updated_at 2021_07_15, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1566, mitre_technique_name Phishing;)