alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET HUNTING Windows Shortcut Link Padded Whitespace in Command Line Arguments (ZDI-CAN-25373)"; flow:established,to_client; http.response_body; content:"|4c 00 00 00 01 14 02 00 00 00 00 00 c0 00 00 00 00 00 00 46 e9 40 00 00|"; fast_pattern; pcre:"/^.*?(?:[\x09\x0a\x0bx0c\x0d\x20]\x00){25,}/R"; reference:url,www.trendmicro.com/en_us/research/25/c/windows-shortcut-zero-day-exploit.html; classtype:attempted-user; sid:2060957; rev:1; metadata:affected_product Windows_XP_Vista_7_8_10_Server_32_64_Bit, attack_target Client_Endpoint, created_at 2025_03_19, deployment Perimeter, deployment Internet, confidence High, signature_severity Major, updated_at 2025_03_19; target:dest_ip;)