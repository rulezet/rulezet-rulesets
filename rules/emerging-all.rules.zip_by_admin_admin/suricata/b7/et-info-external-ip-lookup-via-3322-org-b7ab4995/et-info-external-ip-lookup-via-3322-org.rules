alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"ET INFO External IP Lookup via 3322 .org"; flow:established,to_server; http.method; content:"GET"; http.uri; content:"/getip"; endswith; http.host; content:"3322.org"; endswith; fast_pattern; http.header_names; to_lowercase; content:!"|0d 0a|referer|0d 0a|"; classtype:policy-violation; sid:2033630; rev:3; metadata:affected_product Any, attack_target Client_Endpoint, created_at 2021_07_30, deployment Perimeter, performance_impact Low, confidence High, signature_severity Informational, updated_at 2024_11_26, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1590, mitre_technique_name Gather_Victim_Network_Information;)