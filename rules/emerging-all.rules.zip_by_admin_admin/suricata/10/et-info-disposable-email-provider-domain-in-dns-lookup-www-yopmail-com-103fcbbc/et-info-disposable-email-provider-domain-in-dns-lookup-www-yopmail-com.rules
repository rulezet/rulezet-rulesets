alert dns $HOME_NET any -> any any (msg:"ET INFO Disposable Email Provider Domain in DNS Lookup (www .yopmail .com)"; dns.query; content:"www.yopmail.com"; nocase; startswith; endswith; reference:url,blog.trendmicro.com/trendlabs-security-intelligence/spam-campaign-targets-colombian-entities-with-custom-proyecto-rat-email-service-yopmail-for-cc/; classtype:policy-violation; sid:2027733; rev:4; metadata:attack_target Client_Endpoint, created_at 2019_07_19, deployment Perimeter, performance_impact Low, confidence Medium, signature_severity Minor, updated_at 2024_04_13;)