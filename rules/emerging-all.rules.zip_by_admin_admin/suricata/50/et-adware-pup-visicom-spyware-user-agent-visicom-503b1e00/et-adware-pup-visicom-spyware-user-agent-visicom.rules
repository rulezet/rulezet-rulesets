alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"ET ADWARE_PUP Visicom Spyware User-Agent (Visicom)"; flow:established,to_server; threshold: type limit, count 1, seconds 360, track by_src; http.user_agent; content:"Visicom"; classtype:pup-activity; sid:2001872; rev:32; metadata:attack_target Client_Endpoint, created_at 2010_07_30, deployment Perimeter, confidence High, signature_severity Minor, tag Spyware_User_Agent, updated_at 2024_03_17;)