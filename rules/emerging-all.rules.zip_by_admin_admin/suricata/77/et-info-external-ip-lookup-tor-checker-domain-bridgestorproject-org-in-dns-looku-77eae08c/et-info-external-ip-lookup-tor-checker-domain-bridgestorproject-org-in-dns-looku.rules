alert dns $HOME_NET any -> any any (msg:"ET INFO External IP Lookup / Tor Checker Domain (bridges.torproject .org in DNS lookup)"; dns.query; content:"bridges.torproject.org"; startswith; nocase; endswith; reference:url,www.torproject.org/docs/bridges.html.en; reference:md5,2e3f7f9b3b4c29aceccab693aeccfa5a; classtype:external-ip-check; sid:2017925; rev:10; metadata:attack_target Client_Endpoint, created_at 2014_01_04, deployment Perimeter, performance_impact Low, confidence High, signature_severity Informational, tag IP_address_lookup_website, updated_at 2024_11_26, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1590, mitre_technique_name Gather_Victim_Network_Information;)