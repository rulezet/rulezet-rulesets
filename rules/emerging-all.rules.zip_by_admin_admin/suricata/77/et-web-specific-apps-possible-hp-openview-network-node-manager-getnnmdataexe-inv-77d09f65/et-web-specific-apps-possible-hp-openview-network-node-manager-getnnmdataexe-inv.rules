alert http $EXTERNAL_NET any -> $HTTP_SERVERS any (msg:"ET WEB_SPECIFIC_APPS Possible HP OpenView Network Node Manager Getnnmdata.exe Invalid Hostname Remote Code Execution Attempt"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/OvCgi/getnnmdata.exe"; fast_pattern; nocase; http.request_body; content:"Hostname="; nocase; isdataat:1000,relative; content:!"|0a|"; within:1000; reference:url,www.zerodayinitiative.com/advisories/ZDI-10-086/; reference:cve,2010-1555; classtype:web-application-attack; sid:2011198; rev:5; metadata:created_at 2010_07_30, confidence Medium, signature_severity Major, updated_at 2024_03_11, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public_Facing_Application;)