alert http1 $EXTERNAL_NET any -> $HOME_NET any (msg:"ET CURRENT_EVENTS RedKit - Jar File Naming Algorithm"; flow:established,to_client; http.header; content:"Content-Disposition|3a 20|inline"; nocase; content:".jar|0d 0a|"; fast_pattern; pcre:"/^Content-Disposition: inline[^\r\n]+=[0-9a-f]{8}\.jar[\r\n]+$/mi"; file.data; content:"PK"; startswith; classtype:exploit-kit; sid:2014892; rev:4; metadata:created_at 2012_06_14, signature_severity Major, updated_at 2024_04_08;)