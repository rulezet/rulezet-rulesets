alert http $EXTERNAL_NET any -> $HTTP_SERVERS any (msg:"ET WEB_SPECIFIC_APPS JMweb MP3 src Multiple Local File Inclusion"; flow:established,to_server; http.method; content:"GET"; http.uri; content:"?src="; fast_pattern; nocase; content:".php"; pcre:"/(?:listen.php|download.php)/i"; http.uri.raw; pcre:"/(\.\.\/){1}/"; reference:url,www.exploit-db.com/exploits/6669/; classtype:web-application-attack; sid:2008651; rev:9; metadata:affected_product Web_Server_Applications, attack_target Server, created_at 2010_07_30, deployment Perimeter, deployment Internal, deployment Datacenter, confidence High, signature_severity Major, tag Local_File_Inclusion, tag Exploit, tag LFI, tag RFI, updated_at 2024_03_17, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public_Facing_Application; target:dest_ip;)