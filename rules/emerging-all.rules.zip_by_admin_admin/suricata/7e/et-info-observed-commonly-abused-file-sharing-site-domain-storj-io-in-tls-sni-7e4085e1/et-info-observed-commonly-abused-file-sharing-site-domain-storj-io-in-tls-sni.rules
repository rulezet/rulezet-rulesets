alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"ET INFO Observed Commonly Abused File Sharing Site Domain (storj .io) in TLS SNI"; flow:established,to_server; tls.sni; dotprefix; content:".storj.io"; endswith; fast_pattern; classtype:misc-activity; sid:2058013; rev:1; metadata:affected_product Any, attack_target Client_and_Server, created_at 2024_12_02, deployment Perimeter, performance_impact Low, confidence High, signature_severity Informational, updated_at 2024_12_02, mitre_tactic_id TA0010, mitre_tactic_name Exfiltration, mitre_technique_id T1567, mitre_technique_name Exfiltration_Over_Web_Service;)