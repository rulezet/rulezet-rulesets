alert http $EXTERNAL_NET any -> $HTTP_SERVERS any (msg:"ET WEB_SPECIFIC_APPS FCMS settings.php current_user_id Parameter Remote File Inclusion Attempt"; flow:established,to_server; http.method; content:"GET"; http.uri; content:"/settings.php?"; nocase; content:"current_user_id="; nocase; pcre:"/current_user_id=\s*(ftps?|https?|php)\:\//i"; reference:url,exploit-db.com/exploits/14965/; classtype:web-application-attack; sid:2011553; rev:4; metadata:created_at 2010_09_27, signature_severity Major, updated_at 2020_09_10, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public_Facing_Application;)