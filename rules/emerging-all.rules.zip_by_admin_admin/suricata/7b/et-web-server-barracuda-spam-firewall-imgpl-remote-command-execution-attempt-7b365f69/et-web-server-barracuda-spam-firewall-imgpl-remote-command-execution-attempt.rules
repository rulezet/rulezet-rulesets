alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET WEB_SERVER Barracuda Spam Firewall img.pl Remote Command Execution Attempt"; flow:established,to_server; http.uri; content:"/cgi-bin/img.pl?"; fast_pattern; nocase; pcre:"/(f=.+\|)/i"; reference:bugtraq,14712; classtype:web-application-attack; sid:2002362; rev:8; metadata:created_at 2010_07_30, signature_severity Major, updated_at 2024_03_16;)