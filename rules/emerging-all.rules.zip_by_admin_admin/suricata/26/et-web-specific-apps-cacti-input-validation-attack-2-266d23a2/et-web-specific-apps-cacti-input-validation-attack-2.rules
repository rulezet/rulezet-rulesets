alert http $EXTERNAL_NET any -> $HTTP_SERVERS any (msg:"ET WEB_SPECIFIC_APPS Cacti Input Validation Attack 2"; flow:established,to_server; http.method; content:"GET"; http.uri; content:"config_settings.php"; fast_pattern; pcre:"/config_settings\.php\?.*=(http|https)\x3a\//i"; reference:url,www.cacti.net; reference:url,www.idefense.com/application/poi/display?id=265&type=vulnerabilities; reference:url,www.idefense.com/application/poi/display?id=266&type=vulnerabilities; classtype:web-application-activity; sid:2013993; rev:3; metadata:created_at 2011_12_07, signature_severity Major, updated_at 2024_03_16;)