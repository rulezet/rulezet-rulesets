alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"ET REMOTE_ACCESS Observed Teamviewer Frontline Related Domain (svc .frontlineworker .com) in TLS SNI"; flow:established,to_server; tls.sni; dotprefix; content:".svc.frontlineworker.com"; endswith; fast_pattern; reference:url,www.teamviewer.com/en-us/global/support/knowledge-base/teamviewer-frontline/installation-and-configuration/system-requirements/network-requirements/; classtype:misc-activity; sid:2060625; rev:1; metadata:affected_product Any, attack_target Client_and_Server, created_at 2025_03_05, deployment Perimeter, performance_impact Low, confidence High, signature_severity Informational, tag RMM, tag TeamViewer_Frontline, updated_at 2025_03_05, mitre_tactic_id TA0011, mitre_tactic_name Command_And_Control, mitre_technique_id T1219, mitre_technique_name Remote_Access_Software;)