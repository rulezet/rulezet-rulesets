alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"ET REMOTE_ACCESS Observed TeamViewer RMM Related Domain (teamviewer .com) in TLS SNI"; flow:established,to_server; content:!"www"; tls.sni; dotprefix; content:".teamviewer.com"; endswith; fast_pattern; threshold:type limit, seconds 180, count 1, track by_src; threshold:type limit, seconds 180, count 1, track by_src; reference:url,www.teamviewer.com; classtype:misc-activity; sid:2060632; rev:1; metadata:affected_product Any, attack_target Client_and_Server, created_at 2025_03_05, deployment Perimeter, performance_impact Low, confidence High, signature_severity Informational, tag Teamviewer, tag RMM, updated_at 2025_03_05, mitre_tactic_id TA0011, mitre_tactic_name Command_And_Control, mitre_technique_id T1219, mitre_technique_name Remote_Access_Software;)