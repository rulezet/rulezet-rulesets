alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET WEB_SPECIFIC_APPS phpBB3 Brute-Force reg attempt (Bad pf_XXXXX)"; flow:established,to_server; flowbits:isset,ET.phpBB3_test; flowbits:unset,ET.phpBB3_test; content:"username="; content:"email="; content:"pf_XXXXX="; pcre:!"/^YYY$/R"; http.method; content:"POST"; http.uri; content:"/ucp.php"; fast_pattern; nocase; content:"mode=register"; classtype:web-application-attack; sid:2010895; rev:5; metadata:created_at 2010_07_30, signature_severity Major, updated_at 2024_03_17;)