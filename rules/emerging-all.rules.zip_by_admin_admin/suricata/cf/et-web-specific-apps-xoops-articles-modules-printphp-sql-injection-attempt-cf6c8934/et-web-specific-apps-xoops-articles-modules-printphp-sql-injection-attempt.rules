alert http $EXTERNAL_NET any -> $HTTP_SERVERS any (msg:"ET WEB_SPECIFIC_APPS Xoops Articles modules print.php SQL injection attempt"; flow:established,to_server; http.uri; content:"/print.php?"; fast_pattern; nocase; content:"id="; nocase; pcre:"/id=-?\d+.+UNION.+SELECT/i"; reference:bugtraq,23160; classtype:web-application-attack; sid:2003516; rev:7; metadata:affected_product Web_Server_Applications, attack_target Web_Server, created_at 2010_07_30, deployment Datacenter, signature_severity Major, tag SQL_Injection, updated_at 2024_03_16, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public_Facing_Application;)