alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET WEB_SERVER Barracuda Spam Firewall img.pl Remote Directory Traversal Attempt"; flow:established,to_server; http.uri; content:"/cgi-bin/img.pl?"; fast_pattern; nocase; pcre:"/(f=\.\..+)/i"; reference:bugtraq,14710; classtype:web-application-attack; sid:2002685; rev:9; metadata:created_at 2010_07_30, deployment Perimeter, deployment Internal, confidence High, signature_severity Major, updated_at 2024_11_26, mitre_tactic_id TA0007, mitre_tactic_name Discovery, mitre_technique_id T1083, mitre_technique_name File_And_Directory_Discovery; target:dest_ip;)