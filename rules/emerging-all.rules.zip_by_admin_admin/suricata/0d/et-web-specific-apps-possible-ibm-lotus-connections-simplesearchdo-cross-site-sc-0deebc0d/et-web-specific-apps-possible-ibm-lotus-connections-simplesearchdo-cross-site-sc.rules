alert http $EXTERNAL_NET any -> $HTTP_SERVERS any (msg:"ET WEB_SPECIFIC_APPS Possible IBM Lotus Connections simpleSearch.do Cross-Site Scripting Attempt"; flow:established,to_server; http.uri; content:"/profiles/html/simpleSearch.do?name="; nocase; pcre:"/name=.+(IMG|SCRIPT|SRC|onkey|onmouse|onload)/i"; reference:url,www.securitytracker.com/alerts/2009/Sep/1022945.html; classtype:web-application-attack; sid:2009990; rev:7; metadata:created_at 2010_07_30, confidence Medium, signature_severity Major, updated_at 2020_09_11;)