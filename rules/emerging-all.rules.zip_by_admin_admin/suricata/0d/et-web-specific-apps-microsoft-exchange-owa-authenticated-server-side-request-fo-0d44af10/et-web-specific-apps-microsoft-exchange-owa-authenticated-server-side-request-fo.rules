alert http any any -> $HOME_NET any (msg:"ET WEB_SPECIFIC_APPS Microsoft Exchange OWA Authenticated Server-Side Request Forgery (usd-2021-0021) M2"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/owa/service.svc|3f|action|3d|newapp"; fast_pattern; startswith; nocase; http.header; to_lowercase; content:"x-owa-urlpostdata|3a 20|"; content:"newappdatarequest"; pcre:"/^[^\x0d\x0a]*?(?:\x22|\x2522)ur[il](?:\x22|\x2522)(?:\x3a|\x253a)/R"; reference:url,herolab.usd.de/en/security-advisories/usd-2021-0021/; classtype:web-application-attack; sid:2063627; rev:1; metadata:affected_product Microsoft_Exchange, attack_target Server, tls_state TLSDecrypt, created_at 2025_07_21, deployment Perimeter, deployment Internal, confidence High, signature_severity Major, tag Exploit, updated_at 2025_07_21, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public_Facing_Application; target:dest_ip;)