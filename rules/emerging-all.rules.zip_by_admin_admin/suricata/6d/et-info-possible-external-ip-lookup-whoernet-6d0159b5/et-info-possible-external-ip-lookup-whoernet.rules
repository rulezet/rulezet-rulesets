alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"ET INFO Possible External IP Lookup whoer.net"; flow:established,to_server; http.host; bsize:9; content:"whoer.net"; fast_pattern; http.header_names; to_lowercase; content:!"|0d 0a|referer|0d 0a|"; classtype:external-ip-check; sid:2021195; rev:9; metadata:attack_target Client_Endpoint, created_at 2015_06_08, deployment Perimeter, performance_impact Low, confidence High, signature_severity Informational, tag IP_address_lookup_website, updated_at 2024_11_26, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1590, mitre_technique_name Gather_Victim_Network_Information;)