alert http $EXTERNAL_NET any -> $HTTP_SERVERS any (msg:"ET WEB_SPECIFIC_APPS Wordpress Plugin Page Flip Image Gallery getConfig.php book_id parameter Remote File Disclosure"; flow:established,to_server; http.method; content:"GET"; http.uri; content:"/books/getConfig.php?"; nocase; fast_pattern; content:"book_id="; nocase; distance:0; pcre:"/(\.\.\/){1,}/"; reference:url,www.milw0rm.com/exploits/7543; reference:bugtraq,32966; classtype:web-application-attack; sid:2009010; rev:8; metadata:affected_product Wordpress, affected_product Wordpress_Plugins, attack_target Web_Server, created_at 2010_07_30, deployment Datacenter, signature_severity Major, tag Wordpress, updated_at 2024_03_06;)