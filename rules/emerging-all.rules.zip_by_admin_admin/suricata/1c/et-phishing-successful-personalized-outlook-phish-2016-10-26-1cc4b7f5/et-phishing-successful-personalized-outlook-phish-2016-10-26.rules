alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"ET PHISHING Successful Personalized Outlook Phish 2016-10-26"; flow:established,to_server; http.method; content:"POST"; http.uri; content:".php"; nocase; endswith; http.header; content:"/?email="; fast_pattern; pcre:"/\/\?email=[a-zA-Z0-9+&*-]+(?:\.[a-zA-Z0-9_+&*-]+)*@(?:[a-zA-Z0-9-]+\.)+[a-zA-Z]{2,7}\x0d\x0a/i"; http.request_body; content:"login="; startswith; nocase; content:"&passwd="; nocase; distance:0; classtype:credential-theft; sid:2032614; rev:7; metadata:affected_product Web_Browsers, attack_target Client_Endpoint, created_at 2016_10_26, deployment Perimeter, confidence Medium, signature_severity Critical, tag Phishing, updated_at 2024_04_13, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1566, mitre_technique_name Phishing;)