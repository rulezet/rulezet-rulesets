alert http $EXTERNAL_NET any -> $HTTP_SERVERS any (msg:"ET WEB_SPECIFIC_APPS ViArt Shop Evaluation ajax_list_tree.php Remote File Inclusion Attempt"; flow:established,to_server; http.uri; content:"/includes/ajax_list_tree.php?"; nocase; content:"root_folder_path="; fast_pattern; nocase; pcre:"/root\_folder\_path=\s*(?:(?:ht|f)tps?|data|php)\x3a\//i"; reference:url,packetstormsecurity.org/files/116871/ViArt-Shop-Evaluation-4.1-Remote-File-Inclusion.html; classtype:web-application-attack; sid:2016003; rev:4; metadata:created_at 2012_12_08, signature_severity Major, updated_at 2020_09_17, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public_Facing_Application;)