alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"ET INFO Observed Abused File Sharing Domain in TLS SNI (filebin .net)"; flow:established,to_server; tls.sni; dotprefix; content:".filebin.net"; endswith; fast_pattern; reference:url,filebin.net; classtype:misc-activity; sid:2061029; rev:1; metadata:affected_product Any, attack_target Client_and_Server, created_at 2025_03_24, deployment Perimeter, performance_impact Low, confidence High, signature_severity Informational, updated_at 2025_03_24;)