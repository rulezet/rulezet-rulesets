alert http1 $HOME_NET any -> $EXTERNAL_NET any (msg:"ET USER_AGENTS Lowercase User-Agent header purporting to be MSIE"; flow:established,to_server; http.protocol; content:"HTTP/1"; startswith; http.header_names; content:"|0d 0a|user-agent|0d 0a|"; fast_pattern; http.user_agent; content:"Mozilla/4.0|20|(compatible|3b 20|MSIE|20|"; content:!"|0d 0a|VIA|3a 20|"; classtype:trojan-activity; sid:2012607; rev:6; metadata:created_at 2011_03_31, confidence High, signature_severity Informational, updated_at 2024_04_09;)