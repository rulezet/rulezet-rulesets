alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET WEB_SPECIFIC_APPS Comtrend ADSL Router srvName parameter XSS attempt"; flow:established,to_server; http.method; content:"GET"; http.uri; content:"/scvrtsrv.cmd?"; nocase; content:"srvName="; nocase; pcre:"/(script|onmouse[a-z]+|onkey[a-z]+|onload|onunload|ondragdrop|onblur|onfocus|onclick|ondblclick|onsubmit|onreset|onselect|onchange)/i"; reference:url,packetstorm.foofus.com/1001-exploits/comtrend-xss.txt; reference:url,xforce.iss.net/xforce/xfdb/47765; classtype:web-application-attack; sid:2011019; rev:7; metadata:created_at 2010_07_30, signature_severity Major, updated_at 2020_09_10;)