alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"ET HUNTING Possible EXE Download From Suspicious TLD (.gdn) - set"; flow:established,to_server; flowbits:set,ET.SuspExeTLDs; flowbits:noalert; http.host; content:".gdn"; fast_pattern; pcre:"/^(?:\x3a\d{1,5})?$/"; reference:url,www.spamhaus.org/statistics/tlds/; classtype:misc-activity; sid:2023458; rev:4; metadata:affected_product Any, attack_target Client_and_Server, created_at 2016_10_27, confidence Medium, signature_severity Minor, updated_at 2020_08_24;)