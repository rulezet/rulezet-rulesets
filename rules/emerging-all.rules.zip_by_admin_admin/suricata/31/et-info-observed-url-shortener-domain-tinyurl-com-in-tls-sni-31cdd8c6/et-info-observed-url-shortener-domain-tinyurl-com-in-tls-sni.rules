alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"ET INFO Observed URL Shortener Domain (tinyurl .com) in TLS SNI"; flow:established,to_server; tls.sni; dotprefix; content:".tinyurl.com"; endswith; fast_pattern; reference:url,github.com/SigmaHQ/sigma/blob/master/rules/windows/dns_query/dns_query_win_common_malware_hosting_services.yml; classtype:misc-activity; sid:2063092; rev:1; metadata:affected_product Any, attack_target Client_and_Server, created_at 2025_06_20, deployment Perimeter, performance_impact Low, confidence High, signature_severity Informational, updated_at 2025_06_20, mitre_tactic_id TA0011, mitre_tactic_name Command_And_Control, mitre_technique_id T1665, mitre_technique_name Hide_Infrastructure;)