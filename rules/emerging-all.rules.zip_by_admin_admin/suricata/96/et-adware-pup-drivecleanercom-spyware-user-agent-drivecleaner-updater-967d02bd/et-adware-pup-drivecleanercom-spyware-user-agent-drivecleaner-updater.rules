alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"ET ADWARE_PUP Drivecleaner.com Spyware User-Agent (DriveCleaner Updater)"; flow:established,to_server; http.user_agent; bsize:20; content:"DriveCleaner Updater"; reference:url,www.drivecleaner.com; reference:url,research.sunbelt-software.com/threatdisplay.aspx?name=DriveCleaner&threatid=44533; classtype:pup-activity; sid:2003486; rev:14; metadata:attack_target Client_Endpoint, created_at 2010_07_30, deployment Perimeter, confidence High, signature_severity Minor, tag Spyware_User_Agent, tag Description_Generated_By_Proofpoint_Nexus, updated_at 2024_03_27, mitre_tactic_id TA0040, mitre_tactic_name Impact, mitre_technique_id T1496, mitre_technique_name Resource_Hijacking;)