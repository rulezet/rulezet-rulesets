alert tls $EXTERNAL_NET any -> $HOME_NET any (msg:"ET INFO DNS Over HTTPS Certificate Inbound (dns .hanahira .dev)"; flow:established,to_client; tls.cert_subject; content:"dns.hanahira.dev"; fast_pattern; pcre:"/CN=(?:[^\r\n]+?\.)?dns\.hanahira\.dev(?!\.)/"; reference:url,github.com/curl/curl/wiki/DNS-over-HTTPS; classtype:misc-activity; sid:2045826; rev:1; metadata:attack_target Client_Endpoint, created_at 2023_05_23, deployment Perimeter, confidence High, signature_severity Informational, tag Description_Generated_By_Proofpoint_Nexus, updated_at 2023_05_23;)