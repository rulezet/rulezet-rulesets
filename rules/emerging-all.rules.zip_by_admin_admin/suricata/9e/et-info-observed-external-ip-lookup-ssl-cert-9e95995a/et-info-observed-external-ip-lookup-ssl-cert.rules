alert tls $EXTERNAL_NET any -> $HOME_NET any (msg:"ET INFO Observed External IP Lookup SSL Cert"; flow:established,to_client; tls.cert_subject; content:".iplocation.com"; nocase; fast_pattern; tls.cert_issuer; content:"C=US, O=Let's Encrypt, CN=Let's Encrypt Authority X3"; classtype:external-ip-check; sid:2026882; rev:5; metadata:attack_target Client_Endpoint, created_at 2019_02_05, deployment Perimeter, performance_impact Low, confidence High, signature_severity Informational, tag IP_address_lookup_website, updated_at 2024_09_19, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1590, mitre_technique_name Gather_Victim_Network_Information;)