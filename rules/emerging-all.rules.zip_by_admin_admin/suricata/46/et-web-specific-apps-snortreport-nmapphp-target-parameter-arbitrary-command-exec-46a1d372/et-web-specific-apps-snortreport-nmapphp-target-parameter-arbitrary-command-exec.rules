alert http $EXTERNAL_NET any -> $HTTP_SERVERS any (msg:"ET WEB_SPECIFIC_APPS SnortReport nmap.php target Parameter Arbitrary Command Execution Attempt"; flow:established,to_server; http.method; content:"GET"; http.uri; content:"/nmap.php?"; fast_pattern; nocase; content:"target="; nocase; pcre:"/target=\w*\x3b/i"; reference:url,osvdb.org/show/osvdb/67739; classtype:web-application-attack; sid:2011555; rev:3; metadata:created_at 2010_09_27, signature_severity Major, updated_at 2024_03_18;)