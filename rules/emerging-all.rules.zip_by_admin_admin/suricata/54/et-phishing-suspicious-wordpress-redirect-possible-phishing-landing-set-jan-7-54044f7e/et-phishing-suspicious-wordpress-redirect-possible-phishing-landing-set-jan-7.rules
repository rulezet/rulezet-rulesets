alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"ET PHISHING Suspicious Wordpress Redirect - Possible Phishing Landing (set) Jan 7"; flow:established,to_server; flowbits:set,ET.wpphish; flowbits:noalert; http.method; content:"GET"; http.uri; content:"/wp-"; startswith; fast_pattern; http.header_names; to_lowercase; content:!"|0d 0a|referer|0d 0a|"; classtype:social-engineering; sid:2025696; rev:7; metadata:affected_product Wordpress, affected_product Wordpress_Plugins, attack_target Client_Endpoint, created_at 2016_01_08, deployment Perimeter, deployment Datacenter, performance_impact Significant, confidence Medium, signature_severity Critical, tag Phishing, tag Wordpress, updated_at 2024_05_02, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1566, mitre_technique_name Phishing;)