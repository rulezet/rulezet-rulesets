alert http $EXTERNAL_NET any -> $HTTP_SERVERS any (msg:"ET WEB_SPECIFIC_APPS PHPOutsourcing Zorum prod.php Remote Command Execution Attempt"; flow:established,to_server; http.uri; content:"/prod.php?"; fast_pattern; nocase; pcre:"/(argv[1]=\|.+)/"; reference:bugtraq,14601; classtype:web-application-attack; sid:2002314; rev:9; metadata:created_at 2010_07_30, signature_severity Major, updated_at 2024_03_16;)