alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"ET PHISHING Redirect to Adobe Shared Document Phishing M3 2016-04-18"; flow:established,to_server; http.method; content:"GET"; http.uri; content:"/pdf.adobe.cloud/"; fast_pattern; content:".php"; endswith; http.referer; content:".php"; endswith; classtype:social-engineering; sid:2032678; rev:11; metadata:attack_target Client_Endpoint, created_at 2016_04_18, deployment Perimeter, confidence Medium, signature_severity Major, tag Phishing, updated_at 2024_03_07;)