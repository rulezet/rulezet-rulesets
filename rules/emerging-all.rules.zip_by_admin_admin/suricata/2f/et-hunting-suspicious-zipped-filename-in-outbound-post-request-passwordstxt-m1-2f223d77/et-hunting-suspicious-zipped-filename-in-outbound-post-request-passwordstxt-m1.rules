alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"ET HUNTING Suspicious Zipped Filename in Outbound POST Request (passwords.txt) M1"; flow:established,to_server; http.method; content:"POST"; http.request_body; content:"PK"; startswith; content:"passwords.txt"; distance:26; within:50; nocase; fast_pattern; classtype:trojan-activity; sid:2027105; rev:4; metadata:affected_product Windows_XP_Vista_7_8_10_Server_32_64_Bit, attack_target Client_Endpoint, created_at 2019_03_20, deployment Perimeter, performance_impact Low, confidence Medium, signature_severity Major, tag Stealer, updated_at 2024_04_13;)