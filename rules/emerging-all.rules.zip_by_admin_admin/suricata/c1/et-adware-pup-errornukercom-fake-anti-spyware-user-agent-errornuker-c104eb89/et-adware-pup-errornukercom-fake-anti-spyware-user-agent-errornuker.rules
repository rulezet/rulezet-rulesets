alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"ET ADWARE_PUP Errornuker.com Fake Anti-Spyware User-Agent (ERRORNUKER)"; flow:established,to_server; http.user_agent; content:"ERRORNUKER"; nocase; startswith; reference:url,www.spywarewarrior.com/rogue_anti-spyware.htm; reference:url,www.errornuker.com; classtype:pup-activity; sid:2003478; rev:14; metadata:attack_target Client_Endpoint, created_at 2010_07_30, deployment Perimeter, confidence High, signature_severity Minor, tag Spyware_User_Agent, updated_at 2024_04_13;)