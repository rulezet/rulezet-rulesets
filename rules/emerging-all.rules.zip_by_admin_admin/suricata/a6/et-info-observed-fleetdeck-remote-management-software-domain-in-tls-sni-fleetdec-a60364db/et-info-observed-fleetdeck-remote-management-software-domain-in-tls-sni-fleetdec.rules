alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"ET INFO Observed Fleetdeck Remote Management Software Domain in TLS SNI (fleetdeck .io)"; flow:established,to_server; tls.sni; dotprefix; content:".fleetdeck.io"; endswith; fast_pattern; reference:url,fleetdeck.io; classtype:misc-activity; sid:2047670; rev:1; metadata:affected_product Any, attack_target Client_Endpoint, created_at 2023_08_17, deployment Perimeter, performance_impact Low, confidence High, signature_severity Informational, updated_at 2023_08_17, reviewed_at 2023_08_17;)