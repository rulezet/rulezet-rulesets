alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"ET INFO Observed External IP Lookup Domain (ip .360 .cn) in TLS SNI"; flow:established,to_server; tls.sni; bsize:9; content:"ip.360.cn"; fast_pattern; reference:url,github.com/SigmaHQ/sigma/blob/master/rules/windows/dns_query/dns_query_win_susp_external_ip_lookup.yml; classtype:misc-activity; sid:2063078; rev:1; metadata:affected_product Any, attack_target Client_and_Server, created_at 2025_06_18, deployment Perimeter, performance_impact Low, confidence High, signature_severity Informational, updated_at 2025_06_18;)