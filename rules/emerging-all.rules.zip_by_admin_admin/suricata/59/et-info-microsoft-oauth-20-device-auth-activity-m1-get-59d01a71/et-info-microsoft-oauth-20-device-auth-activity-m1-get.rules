alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"ET INFO Microsoft OAuth 2.0 Device Auth Activity M1 (GET)"; flow:established,to_server; http.method; content:"GET"; http.uri; bsize:25; content:"/common/oauth2/deviceauth"; fast_pattern; http.host; content:"login.microsoftonline.com"; reference:url,learn.microsoft.com/en-us/entra/identity-platform/v2-oauth2-device-code#device-authorization-request; classtype:misc-activity; sid:2060049; rev:1; metadata:attack_target Client_Endpoint, tls_state TLSDecrypt, created_at 2025_02_12, deployment Perimeter, performance_impact Low, confidence High, signature_severity Informational, updated_at 2025_02_12;)