alert tls $EXTERNAL_NET any -> $HOME_NET any (msg:"ET INFO Default PolarSSL/mbedTLS Certificate Subject Observed in Certificate"; flow:established,to_client; tls.cert_subject; bsize:28; content:"C=NL,O=PolarSSL,CN=localhost"; fast_pattern; reference:url,forums.mbed.com/t/mbedtls-ssl-handshake-issue-2/4763; reference:url,blog.sekoia.io/polaredge-unveiling-an-uncovered-iot-botnet/; classtype:misc-activity; sid:2063691; rev:1; metadata:affected_product IoT, attack_target IoT, created_at 2025_07_24, deployment Perimeter, performance_impact Significant, confidence High, signature_severity Informational, tag mbedTLS, tag PolarSSL, updated_at 2025_07_24;)