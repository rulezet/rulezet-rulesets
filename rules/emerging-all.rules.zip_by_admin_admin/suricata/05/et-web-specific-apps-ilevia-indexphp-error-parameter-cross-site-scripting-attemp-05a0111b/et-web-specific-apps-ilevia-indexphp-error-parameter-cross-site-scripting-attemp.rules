alert http any any -> $HOME_NET any (msg:"ET WEB_SPECIFIC_APPS Ilevia index.php error Parameter Cross Site Scripting Attempt"; flow:established,to_server; http.method; content:"GET"; http.uri; content:"/index.php|3f|"; startswith; fast_pattern; content:"error|3d|"; distance:0; pcre:"/^.*(?:on(?:(?:error)|(?:s(?:elec|ubmi)|rese)t|d(?:blclick|ragdrop)|(?:mouse|key)[a-z]|c(?:hange|lick)|(?:un)?load|focus|blur)|s(?:cript|tyle))(?:=|%3[dD])?/Ri"; reference:url,www.zeroscience.mk/codes/ilevia_xss.txt; classtype:web-application-attack; sid:2065365; rev:1; metadata:affected_product Ilevia, attack_target Networking_Equipment, tls_state plaintext, created_at 2025_10_23, deployment Perimeter, deployment Internal, performance_impact Moderate, confidence High, signature_severity Major, tag Exploit, tag Description_Generated_By_Proofpoint_Nexus, updated_at 2025_10_23, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public_Facing_Application; target:dest_ip;)