alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"ET USER_AGENTS Suspicious User-Agent (My Session)"; flow:established,to_server; http.user_agent; content:"my session"; nocase; startswith; fast_pattern; http.host; content:!".windows.net"; endswith; content:!"aquaveo.com"; endswith; classtype:pup-activity; sid:2010677; rev:14; metadata:affected_product Any, attack_target Client_Endpoint, created_at 2010_07_30, deployment Perimeter, confidence High, signature_severity Minor, tag User_Agent, updated_at 2025_12_05;)