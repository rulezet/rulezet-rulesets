alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"ET USER_AGENTS Suspicious User-Agent outbound (bot)"; flow:established,to_server; threshold: type limit, count 3, seconds 300, track by_src; http.user_agent; content:"bot/"; startswith; nocase; classtype:trojan-activity; sid:2003622; rev:17; metadata:affected_product Any, attack_target Client_Endpoint, created_at 2010_07_30, deployment Perimeter, confidence High, signature_severity Major, tag User_Agent, updated_at 2024_04_13;)