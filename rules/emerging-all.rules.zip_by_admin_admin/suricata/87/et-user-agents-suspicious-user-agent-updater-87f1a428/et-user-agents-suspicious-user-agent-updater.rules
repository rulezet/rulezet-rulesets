alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"ET USER_AGENTS Suspicious User-Agent (Updater)"; flow:established,to_server; http.user_agent; content:"Updater"; startswith; threshold:type limit, count 3, seconds 300, track by_src; classtype:trojan-activity; sid:2003584; rev:11; metadata:affected_product Any, attack_target Client_Endpoint, created_at 2010_07_30, deployment Perimeter, confidence High, signature_severity Major, tag User_Agent, updated_at 2024_03_12;)