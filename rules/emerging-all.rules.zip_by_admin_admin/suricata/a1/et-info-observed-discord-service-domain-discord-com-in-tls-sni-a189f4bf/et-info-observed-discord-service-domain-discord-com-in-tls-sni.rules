alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"ET INFO Observed Discord Service Domain (discord .com) in TLS SNI"; flow:established,to_server; tls.sni; bsize:11; content:"discord.com"; fast_pattern; reference:url,discord.com/developers/docs/events/gateway; classtype:misc-activity; sid:2060505; rev:1; metadata:affected_product Any, attack_target Client_Endpoint, created_at 2025_02_28, deployment Perimeter, performance_impact Low, confidence High, signature_severity Informational, tag Discord, tag Chat_Service, updated_at 2025_02_28, mitre_tactic_id TA0011, mitre_tactic_name Command_And_Control, mitre_technique_id T1573, mitre_technique_name Encrypted_Channel;)