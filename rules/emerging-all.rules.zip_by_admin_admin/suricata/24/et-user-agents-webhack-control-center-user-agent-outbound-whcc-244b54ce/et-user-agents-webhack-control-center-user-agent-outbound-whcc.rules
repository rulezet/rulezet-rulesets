alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"ET USER_AGENTS WebHack Control Center User-Agent Outbound (WHCC/)"; flow:established,to_server; http.user_agent; content:"WHCC"; nocase; reference:url,www.governmentsecurity.org/forum/index.php?showtopic=5112&pid=28561&mode=threaded&start=; classtype:trojan-activity; sid:2003925; rev:8; metadata:created_at 2010_07_30, confidence High, signature_severity Informational, updated_at 2024_01_24;)