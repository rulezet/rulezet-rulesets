alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET WEB_SERVER Oracle Reports DESFORMAT Information Disclosure"; flow:established,to_server; http.method; content:"GET"; nocase; http.uri; content:"destype=file"; fast_pattern; nocase; content:"desformat="; nocase; pcre:"/(?:showenv|parsequery|rwservlet)\?.*destype=file.*desformat=\//i"; reference:url,www.oracle.com/technology/products/reports/index.html; reference:url,www.red-database-security.com/advisory/oracle_reports_read_any_file.html; classtype:web-application-activity; sid:2002132; rev:12; metadata:created_at 2010_07_30, signature_severity Unknown, updated_at 2024_03_19, mitre_tactic_id TA0007, mitre_tactic_name Discovery, mitre_technique_id T1082, mitre_technique_name System_Information_Discovery;)