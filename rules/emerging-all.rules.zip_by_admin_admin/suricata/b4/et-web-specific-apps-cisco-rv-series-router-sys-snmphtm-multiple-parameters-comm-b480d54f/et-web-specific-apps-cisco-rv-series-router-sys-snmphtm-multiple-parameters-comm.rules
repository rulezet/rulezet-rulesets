alert http any any -> $HOME_NET any (msg:"ET WEB_SPECIFIC_APPS Cisco RV Series Router sys_snmp.htm Multiple Parameters Command Injection Attempt"; flow:established,to_server; http.method; content:"POST"; http.uri; bsize:13; content:"/sys_snmp.htm"; fast_pattern; http.request_body; pcre:"/(?:snmp_Mib2SysName|snmp_Mib2SysContact|snmp_Mib2SysLocation)\x3d.*(?:(?:\x3b|%3[Bb])|(?:\x0a|%0[Aa])|(?:\x60|%60)|(?:\x7c|%7[Cc])|(?:\x24|%24)|(?:telnetd\x20|sh|bash|wget\x20|curl\x20|cat\x20|ls\x20|IFS|%[eE][aA]))+/"; reference:url,www.iotsec-zone.com/article/383; classtype:web-application-attack; sid:2063638; rev:2; metadata:affected_product Cisco_RV_Series, attack_target Networking_Equipment, tls_state plaintext, created_at 2025_07_21, deployment Perimeter, deployment Internal, performance_impact Low, confidence High, signature_severity Major, tag Exploit, tag Description_Generated_By_Proofpoint_Nexus, updated_at 2025_09_16, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public_Facing_Application; target:dest_ip;)