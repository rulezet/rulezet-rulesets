alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"ET REMOTE_ACCESS Observed Remote Monitoring and Management Domain (centrastage .net in TLS SNI)"; flow:established,to_server; tls.sni; dotprefix; content:".centrastage.net"; endswith; fast_pattern; reference:url,rmm.datto.com/help/en/Content/1INTRODUCTION/Infrastructure/Platforms.htm; classtype:misc-activity; sid:2053825; rev:1; metadata:attack_target Client_Endpoint, created_at 2024_06_24, deployment Perimeter, confidence High, signature_severity Informational, updated_at 2024_06_24;)