alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"ET INFO Observed Web Hosting Domain (atwebpages .com in TLS SNI)"; flow:established,to_server; tls.sni; dotprefix; content:".atwebpages.com"; endswith; fast_pattern; threshold:type limit,count 1,seconds 300,track by_src; classtype:misc-activity; sid:2064335; rev:1; metadata:attack_target Client_Endpoint, created_at 2025_09_04, deployment Perimeter, confidence High, signature_severity Informational, updated_at 2025_09_04;)