alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"ET TA_ABUSED_SERVICES Observed Commonly Actor Abused Cloud Hosting Service Domain (vercel .app in TLS SNI)"; flow:established,to_server; tls.sni; dotprefix; content:".vercel.app"; endswith; fast_pattern; threshold:type limit,count 1,seconds 300,track by_src; classtype:misc-activity; sid:2065178; rev:1; metadata:attack_target Client_Endpoint, created_at 2025_10_14, deployment Perimeter, confidence High, signature_severity Informational, tag TA_Abused_Online_Service, tag Description_Generated_By_Proofpoint_Nexus, updated_at 2025_10_14;)