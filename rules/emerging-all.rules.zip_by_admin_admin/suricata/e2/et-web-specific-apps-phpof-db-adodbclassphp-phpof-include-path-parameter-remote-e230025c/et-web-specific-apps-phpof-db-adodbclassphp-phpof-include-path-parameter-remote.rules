alert http $EXTERNAL_NET any -> $HTTP_SERVERS any (msg:"ET WEB_SPECIFIC_APPS PHPOF DB_AdoDB.Class.PHP PHPOF_INCLUDE_PATH parameter Remote File Inclusion"; flow:established,to_server; http.method; content:"GET"; http.uri; content:"/DB_adodb.class.php?"; nocase; content:"PHPOF_INCLUDE_PATH="; nocase; pcre:"/PHPOF_INCLUDE_PATH=\s*(?:ftps?|https?|php)\:\//i"; reference:bugtraq,25541; classtype:web-application-attack; sid:2009051; rev:6; metadata:created_at 2010_07_30, signature_severity Major, updated_at 2020_09_08, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public_Facing_Application;)