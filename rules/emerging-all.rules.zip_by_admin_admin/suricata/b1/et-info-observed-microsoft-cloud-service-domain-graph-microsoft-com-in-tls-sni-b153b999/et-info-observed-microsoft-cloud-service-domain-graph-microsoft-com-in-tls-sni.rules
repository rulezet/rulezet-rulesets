alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"ET INFO Observed Microsoft Cloud Service Domain (graph .microsoft .com in TLS SNI)"; flow:established,to_server; tls.sni; bsize:19; content:"graph.microsoft.com"; fast_pattern; threshold:type limit,count 1,seconds 300,track by_src; reference:url,www.elastic.co/security-labs/fragile-web-ref7707; classtype:misc-activity; sid:2060162; rev:2; metadata:attack_target Client_Endpoint, created_at 2025_02_18, deployment Perimeter, confidence High, signature_severity Informational, updated_at 2025_02_20;)