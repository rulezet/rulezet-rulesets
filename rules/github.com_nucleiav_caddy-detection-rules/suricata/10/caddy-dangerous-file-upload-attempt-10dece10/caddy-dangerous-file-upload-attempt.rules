alert tcp any any -> $HTTP_SERVERS $HTTP_PORTS (msg:"Caddy: Dangerous File Upload Attempt"; flow:established,to_server; pcre:"/(\/upload|\/uploads|\/files|\/media|\/assets|\/static)[^?]*\.(php[0-9]?|phtml|phar|asp|aspx|jsp|jspx|cfm|cgi|pl|py|rb|sh|exe|dll|bat|cmd|vbs|ps1)/iU"; classtype:web-application-attack; sid:2996029; rev:1; metadata:mitre_technique T1190;)