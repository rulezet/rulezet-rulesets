alert http any any -> any any (msg:"Caddy: Possible Brute Force on Auth Endpoint"; flow:established,to_server; http.uri; pcre:"/\/(login|signin|sign-in|logon|auth|authenticate|wp-login\.php|admin\/login|account\/login|session\/new|user\/login|api\/login|api\/auth|oauth\/token|token)(\/|\?|$)/i"; threshold:type threshold, track by_src, count 10, seconds 60; classtype:web-application-attack; sid:996022; rev:1; metadata:mitre_technique T1110;)