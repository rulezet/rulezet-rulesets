alert ip $HOME_NET any -> any any (msg:"AT IP dataset - Phishing"; ip.dst; dataset:isset,phishing_ips,type ipv4,load /usr/local/etc/suricata/rules/phishing_ips.lst; reference:url,github.com/julioliraup/Antiphishing; reference:url,julioliraup.github.io/AT/signature.html?sid=6000002; classtype:social-engineering; sid:6000002; rev:1; metadata: signature_severity Major, created_et 2026_08_14;)