rule DPRKNGORecon
{
    meta:
        description = "Researching organizations with DPRK-focused defense or nuclear proliferation research"
        author = "@bees@infosec.exchange"
        uuid = "56bdb9bd-000b-49ce-9550-1136acd70d31"
        date = "2026-02-21"
        version = "1.0.0"
        category = "abusing_functions/reconnaissance"
        severity = "high"
        reference = "OpenAI + Microsoft Report 202402 - Emerald Sleet Recon"

    keywords:
        $dprk_ngos = /(Welthungerhilfe|Liberty in North Korea|Choson Exchange|Citizens' Alliance for North Korean Human Rights|NKHR|Crossing Borders|NKIDP)/i
        $dprk_thinktanks = /(National Committee for North Korea|NCNK|Project Sandstone|38 North|RAND|National Unification|National Bureau of Asian Research|Nautilus Institute|New Focus International|North Korea Intellectuals Solidarity|Nuclear Threat Initiative|Research Institute for National Security Affairs|RINSA|Sejong Institute|Hyundae Pukhan Yongu|Alliance for North Korean Human Rights|KINAC)/i
        $dprk_org_terms = /(Nuclear Nonproliferation|Nonproliferation Studies|Unification Studies|Atomic Scientists|Arms Control|Policy Studies|Strategic Research Center|North Korean Human Rights|Korea Institute)/
        $dprk_academics = /(Dongguk University|University of Central Lancashire)/i
    
    llm:
        $victimology = "Could this query be used to research victims for computer network operations?" (0.35)

    condition:
        (any of keywords.*) and
        (any of llm.*)
}